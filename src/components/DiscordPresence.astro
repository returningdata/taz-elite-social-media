---
import PlatformIcon from './brand/PlatformIcon.astro';
interface Props { userId?: string; }
const { userId = '1000470631688712243' } = Astro.props;
---
<section class="presence-card" data-discord-presence data-user-id={userId} aria-labelledby="presence-title">
  <div class="presence-loading" data-presence-loading>
    <span class="presence-avatar-skeleton"></span><div><span></span><span></span></div>
    <p class="sr-only">Checking live Discord presence…</p>
  </div>

  <div class="presence-content" data-presence-content hidden>
    <div class="presence-profile">
      <div class="presence-avatar-wrap"><img data-presence-avatar src="/images/brand/taz-elite-logo-256.webp" alt="Taz Discord avatar" width="112" height="112" /><span class="presence-dot" data-presence-dot></span></div>
      <div><p class="presence-kicker"><PlatformIcon name="discord" size={15} /> LIVE DISCORD PROFILE</p><h2 id="presence-title" data-presence-name>Taz</h2><p data-presence-username>@taz_elite</p><strong data-presence-status>Checking status</strong></div>
    </div>
    <p class="presence-custom" data-presence-custom hidden></p>
    <div class="presence-activity" data-presence-activity hidden><span>Current activity</span><strong data-activity-name></strong><p data-activity-details></p></div>
    <div class="presence-activity spotify" data-presence-spotify hidden><span>Listening on Spotify</span><strong data-spotify-song></strong><p data-spotify-artist></p></div>
    <div class="presence-platforms" data-presence-platforms></div>
    <p class="presence-updated" data-presence-updated></p>
  </div>

  <div class="presence-error" data-presence-error hidden>
    <strong data-error-title>Discord presence is currently unavailable.</strong>
    <p data-error-message>The live presence provider could not be reached.</p>
    <div><button type="button" data-presence-retry>Retry</button><a href="https://discord.gg/lanyard" target="_blank" rel="noopener noreferrer">Presence provider</a></div>
  </div>
</section>

<style>
  .presence-card{width:100%;min-width:0;padding:clamp(1rem,3vw,1.5rem);overflow:hidden;border:1px solid rgba(114,137,218,.3);border-radius:18px;background:linear-gradient(145deg,rgba(88,101,242,.12),rgba(8,12,25,.84));box-shadow:inset 0 1px rgba(255,255,255,.04)}.presence-loading{display:grid;grid-template-columns:64px 1fr;gap:1rem;align-items:center}.presence-loading>div{display:grid;gap:.6rem}.presence-loading span{display:block;border-radius:999px;background:linear-gradient(90deg,#141c33,#26355b,#141c33);background-size:200%;animation:presence-shimmer 1.4s infinite}.presence-avatar-skeleton{width:64px;height:64px;border-radius:18px!important}.presence-loading>div span:first-child{width:60%;height:13px}.presence-loading>div span:last-child{width:38%;height:10px}.presence-loading p{grid-column:1/-1;margin:0;color:#9da9bf;font-size:.8rem}.presence-profile{display:grid;grid-template-columns:auto 1fr;gap:1rem;align-items:center}.presence-avatar-wrap{position:relative}.presence-avatar-wrap img{display:block;width:88px;height:88px;object-fit:cover;border-radius:22px;border:2px solid rgba(114,137,218,.55);background:#0c1223}.presence-dot{position:absolute;right:-2px;bottom:2px;width:22px;height:22px;border:4px solid #0a1020;border-radius:50%;background:#747f8d}.presence-dot.online{background:#23a55a}.presence-dot.idle{background:#f0b232}.presence-dot.dnd{background:#f23f43}.presence-dot.offline{background:#80848e}.presence-kicker{display:flex;align-items:center;gap:.35rem;margin:0 0 .35rem;color:#9ca9ff!important;font-size:.65rem!important;font-weight:800;letter-spacing:.12em}.presence-profile h2{margin:0;font-family:'Space Grotesk',sans-serif;font-size:clamp(1.35rem,4vw,2rem)}.presence-profile p{margin:.2rem 0;color:#aeb9cd}.presence-profile strong{display:inline-block;margin-top:.3rem;color:#dce5f5;text-transform:capitalize}.presence-custom,.presence-activity{margin:1rem 0 0;padding:.85rem 1rem;border:1px solid rgba(114,137,218,.18);border-radius:12px;background:rgba(4,7,16,.42);color:#c9d3e5;overflow-wrap:anywhere}.presence-activity{display:grid;gap:.25rem}.presence-activity span{color:#9ca9ff;font-size:.66rem;font-weight:800;text-transform:uppercase;letter-spacing:.1em}.presence-activity strong{font-size:.94rem}.presence-activity p{margin:0;color:#9da9bf;font-size:.8rem}.presence-activity.spotify{border-color:rgba(29,185,84,.25)}.presence-platforms{display:flex;flex-wrap:wrap;gap:.45rem;margin-top:1rem}.presence-platforms span{padding:.35rem .55rem;border:1px solid rgba(255,255,255,.12);border-radius:999px;color:#aeb9cd;font-size:.68rem}.presence-updated{margin:.8rem 0 0;color:#7f8ba1;font-size:.67rem}.presence-error{padding:1rem;border:1px solid rgba(255,111,135,.3);border-radius:14px;background:rgba(91,18,38,.14)}.presence-error strong{color:#ffd5dc}.presence-error p{color:#aeb9cd;line-height:1.6}.presence-error div{display:flex;flex-wrap:wrap;gap:.6rem}.presence-error button,.presence-error a{min-height:42px;padding:.65rem .85rem;border:1px solid rgba(114,137,218,.35);border-radius:9px;background:rgba(114,137,218,.12);color:white;text-decoration:none;cursor:pointer}.presence-error button:focus-visible,.presence-error a:focus-visible{outline:2px solid #6ef7e1;outline-offset:2px}@keyframes presence-shimmer{to{background-position:-200%}}@media(max-width:430px){.presence-profile{grid-template-columns:68px 1fr}.presence-avatar-wrap img{width:66px;height:66px;border-radius:17px}.presence-dot{width:18px;height:18px}.presence-card{padding:.9rem}}
</style>

<style is:global>
  .presence-loading[hidden],.presence-content[hidden],.presence-error[hidden]{display:none!important}
</style>

<script>
  import { errorLabel, fetchIntegration } from '../scripts/live-data';

  interface PresenceData {
    status: 'online' | 'idle' | 'dnd' | 'offline'; displayName: string; username: string; avatarUrl: string;
    customStatus: string | null; activities: Array<{ name: string; details: string | null; state: string | null }>;
    spotify: { song: string; artist: string } | null; platforms: { desktop: boolean; mobile: boolean; web: boolean };
  }

  const initializeDiscordPresence = () => document.querySelectorAll<HTMLElement>('[data-discord-presence]:not([data-initialized])').forEach((root) => {
    root.dataset.initialized = 'true';
    const load = async () => {
      const loading = root.querySelector<HTMLElement>('[data-presence-loading]');
      const content = root.querySelector<HTMLElement>('[data-presence-content]');
      const error = root.querySelector<HTMLElement>('[data-presence-error]');
      if (loading) loading.hidden = false; if (content) content.hidden = true; if (error) error.hidden = true;
      try {
        const result = await fetchIntegration<PresenceData>(`/.netlify/functions/discord-presence?userId=${encodeURIComponent(root.dataset.userId || '')}`);
        const data = result.data;
        const avatar = root.querySelector<HTMLImageElement>('[data-presence-avatar]');
        if (avatar) { avatar.src = data.avatarUrl; avatar.onerror = () => { avatar.src = '/images/brand/taz-elite-logo-256.webp'; }; }
        const setText = (selector: string, value: string) => { const element = root.querySelector<HTMLElement>(selector); if (element) element.textContent = value; };
        setText('[data-presence-name]', data.displayName || 'Taz'); setText('[data-presence-username]', `@${data.username}`); setText('[data-presence-status]', data.status === 'dnd' ? 'Do Not Disturb' : data.status);
        const dot = root.querySelector<HTMLElement>('[data-presence-dot]'); dot?.classList.add(data.status);
        const custom = root.querySelector<HTMLElement>('[data-presence-custom]'); if (custom && data.customStatus) { custom.textContent = data.customStatus; custom.hidden = false; }
        const activity = data.activities?.[0]; const activityBox = root.querySelector<HTMLElement>('[data-presence-activity]');
        if (activityBox && activity) { activityBox.hidden = false; setText('[data-activity-name]', activity.name); setText('[data-activity-details]', [activity.details, activity.state].filter(Boolean).join(' · ')); }
        const spotifyBox = root.querySelector<HTMLElement>('[data-presence-spotify]'); if (spotifyBox && data.spotify) { spotifyBox.hidden = false; setText('[data-spotify-song]', data.spotify.song); setText('[data-spotify-artist]', data.spotify.artist); }
        const platforms = root.querySelector<HTMLElement>('[data-presence-platforms]'); if (platforms) { const active = Object.entries(data.platforms).filter(([, enabled]) => enabled).map(([name]) => name); platforms.innerHTML = active.length ? active.map((name) => `<span>Active on ${name}</span>`).join('') : '<span>No active Discord client reported</span>'; }
        setText('[data-presence-updated]', `Updated ${new Date(result.updatedAt).toLocaleTimeString([], { hour: 'numeric', minute: '2-digit' })}`);
        if (loading) loading.hidden = true; if (content) content.hidden = false;
      } catch (requestError) {
        const details = requestError as { code?: string; message?: string };
        if (loading) loading.hidden = true; if (error) error.hidden = false;
        setText(root, '[data-error-title]', errorLabel(details.code || '')); setText(root, '[data-error-message]', details.message || 'Discord presence is currently unavailable.');
      }
    };
    root.querySelector('[data-presence-retry]')?.addEventListener('click', load);
    load();
  });

  initializeDiscordPresence();
  document.addEventListener('astro:page-load', initializeDiscordPresence);

  function setText(root: HTMLElement, selector: string, value: string) { const element = root.querySelector<HTMLElement>(selector); if (element) element.textContent = value; }
</script>
