---
---

<header class="site-header">
    <div class="header-inner">
        <a href="/" class="header-brand">
            <img src="/images/taz.gif" alt="TazElite" class="header-logo" />
            <span class="header-title">TazElite</span>
        </a>

        <button id="mobile-menu-btn" class="mobile-menu-btn" aria-label="Toggle menu">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
            </svg>
        </button>

        <nav id="header-nav" class="header-nav">
            <a href="/" class="nav-link">Home</a>
            <a href="/cod-tracker" class="nav-link">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4"/></svg>
                COD Tracker
            </a>
            <a href="/tip" class="nav-link nav-tip">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/></svg>
                Support Me
            </a>
        </nav>
    </div>
</header>

<style>
    .site-header {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        z-index: 40;
        background: rgba(10, 10, 10, 0.85);
        backdrop-filter: blur(20px);
        -webkit-backdrop-filter: blur(20px);
        border-bottom: 1px solid rgba(229, 9, 20, 0.2);
    }

    .header-inner {
        max-width: 72rem;
        margin: 0 auto;
        padding: 0 1.5rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
        height: 64px;
    }

    .header-brand {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        text-decoration: none !important;
    }

    .header-logo {
        width: 36px;
        height: 36px;
        border-radius: 0.5rem;
        box-shadow: 0 0 15px rgba(229, 9, 20, 0.4);
    }

    .header-title {
        font-family: 'Cinzel', Georgia, serif;
        font-weight: 900;
        font-size: 1.25rem;
        color: #e50914;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        text-shadow: 0 0 10px rgba(229, 9, 20, 0.5);
    }

    .header-nav {
        display: flex;
        align-items: center;
        gap: 0.25rem;
    }

    .nav-link {
        display: flex;
        align-items: center;
        gap: 0.4rem;
        padding: 0.5rem 1rem;
        border-radius: 0.5rem;
        font-size: 0.875rem;
        font-weight: 500;
        color: #d1d5db;
        text-decoration: none !important;
        transition: all 0.2s;
        white-space: nowrap;
    }

    .nav-link:hover {
        color: white;
        background: rgba(229, 9, 20, 0.15);
    }

    .nav-tip {
        background: rgba(229, 9, 20, 0.2);
        border: 1px solid rgba(229, 9, 20, 0.4);
        color: #f87171;
    }

    .nav-tip:hover {
        background: rgba(229, 9, 20, 0.35);
        border-color: rgba(229, 9, 20, 0.7);
        color: white;
        box-shadow: 0 0 20px rgba(229, 9, 20, 0.3);
    }

    .mobile-menu-btn {
        display: none;
        padding: 0.5rem;
        color: #d1d5db;
        background: none;
        border: none;
        cursor: pointer;
    }

    @media (max-width: 640px) {
        .mobile-menu-btn {
            display: block;
        }

        .header-nav {
            display: none;
            position: absolute;
            top: 64px;
            left: 0;
            right: 0;
            flex-direction: column;
            background: rgba(10, 10, 10, 0.95);
            backdrop-filter: blur(20px);
            padding: 1rem;
            border-bottom: 1px solid rgba(229, 9, 20, 0.2);
        }

        .header-nav.open {
            display: flex;
        }

        .nav-link {
            width: 100%;
            justify-content: center;
            padding: 0.75rem 1rem;
        }
    }
</style>

<script>
    const menuBtn = document.getElementById('mobile-menu-btn');
    const nav = document.getElementById('header-nav');
    menuBtn?.addEventListener('click', () => {
        nav?.classList.toggle('open');
    });
</script>
