---
const playlistUrl = 'https://youtube.com/playlist?list=RDk04tX2fvh0o&playnext=1&si=XgpP9bphumpmctS4';
---

<aside class="taz-mix" id="taz-mix" aria-label="Taz’s Mix music player" data-playlist-url={playlistUrl} transition:persist="taz-mix">
  <div class="taz-mix__youtube" aria-hidden="true"><div id="taz-mix-youtube"></div></div>

  <button class="taz-mix__collapsed" type="button" aria-label="Expand Taz’s Mix" hidden>
    <img data-thumbnail-mini src="/images/taz-approved/june-2025.jpg" alt="" width="54" height="54" />
    <span class="taz-mix__equalizer" aria-hidden="true"><i></i><i></i><i></i></span>
  </button>

  <div class="taz-mix__expanded">
    <div class="taz-mix__art">
      <img data-thumbnail src="/images/taz-approved/june-2025.jpg" alt="Current Taz’s Mix track artwork" width="68" height="68" />
      <span class="taz-mix__art-loading" data-player-loading aria-label="Loading Taz’s Mix"></span>
      <span class="taz-mix__equalizer taz-mix__equalizer--art" aria-hidden="true"><i></i><i></i><i></i></span>
    </div>

    <div class="taz-mix__main">
      <div class="taz-mix__title-row">
        <div class="taz-mix__track"><span>TAZ’S MIX</span><strong data-track-title>Taz’s Mix</strong></div>
        <div class="taz-mix__window-controls">
          <button type="button" data-action="minimize" aria-label="Minimize Taz’s Mix">−</button>
          <button type="button" data-action="stop" aria-label="Stop Taz’s Mix">×</button>
        </div>
      </div>

      <div class="taz-mix__progress-row">
        <span data-current-time>0:00</span>
        <input type="range" min="0" max="1000" step="1" value="0" data-progress aria-label="Track progress" />
        <span data-duration>0:00</span>
      </div>

      <div class="taz-mix__controls">
        <div class="taz-mix__transport" aria-label="Playback controls">
          <button type="button" data-action="previous" aria-label="Previous track">‹</button>
          <button class="taz-mix__play" type="button" data-action="play" aria-label="Play Taz’s Mix"><span data-play-symbol>▶</span></button>
          <button type="button" data-action="next" aria-label="Next track">›</button>
        </div>
        <label class="taz-mix__volume">
          <button type="button" data-action="mute" aria-label="Mute Taz’s Mix"><span data-mute-symbol>◕</span></button>
          <input type="range" min="0" max="100" step="1" value="25" data-volume aria-label="Taz’s Mix volume: 25 percent" />
          <output data-volume-value>25%</output>
        </label>
      </div>

      <div class="taz-mix__enable" data-enable-panel hidden><p data-enable-message>Autoplay is unavailable on this browser.</p><button type="button" data-action="enable">Play Taz’s Mix</button></div>
      <div class="taz-mix__error" data-error-panel hidden><strong>Player unavailable</strong><p>Taz’s Mix could not load here.</p><a href={playlistUrl} target="_blank" rel="noopener noreferrer">Open on YouTube</a></div>
      <div class="taz-mix__footer"><span data-status role="status" aria-live="polite">Loading player</span><a href={playlistUrl} target="_blank" rel="noopener noreferrer">YouTube ↗</a></div>
    </div>
  </div>
</aside>

<style>
  .taz-mix{--mix-blue:#5bc8ff;--mix-purple:#956cff;--mix-cyan:#6ef7e1;--mix-ink:#f7f9ff;--mix-muted:#8e9bb1;position:fixed;right:max(14px,env(safe-area-inset-right));bottom:max(14px,env(safe-area-inset-bottom));z-index:70;width:min(470px,calc(100vw - 28px));font-family:'Manrope','Inter',system-ui,sans-serif;color:var(--mix-ink);filter:drop-shadow(0 20px 40px rgba(0,0,0,.5))}.taz-mix__youtube{position:fixed;left:-10000px;top:0;width:200px;height:200px;overflow:hidden;pointer-events:none}.taz-mix__youtube iframe{width:200px!important;height:200px!important;border:0}.taz-mix__expanded{display:grid;grid-template-columns:82px minmax(0,1fr);gap:12px;padding:11px;overflow:hidden;border:1px solid rgba(112,183,255,.28);border-radius:18px;background:linear-gradient(145deg,rgba(8,13,29,.97),rgba(5,8,18,.98));box-shadow:inset 0 1px rgba(255,255,255,.05),0 0 38px rgba(70,111,255,.13);backdrop-filter:blur(20px);transform-origin:bottom right;transition:opacity .2s,transform .25s}.taz-mix__art{position:relative;width:82px;height:82px;align-self:center;overflow:hidden;border:1px solid rgba(91,200,255,.27);border-radius:13px;background:#0d1427}.taz-mix__art img{width:100%;height:100%;object-fit:cover;transition:opacity .22s,transform .3s}.taz-mix.is-playing .taz-mix__art img{transform:scale(1.03)}.taz-mix__art::after{content:'';position:absolute;inset:0;background:linear-gradient(145deg,transparent 45%,rgba(2,5,12,.62));pointer-events:none}.taz-mix__art-loading{position:absolute;inset:0;z-index:2;display:grid;place-items:center;background:rgba(4,8,18,.7)}.taz-mix__art-loading::after{content:'';width:23px;height:23px;border:2px solid rgba(91,200,255,.18);border-top-color:var(--mix-blue);border-radius:50%;animation:taz-mix-spin .8s linear infinite}.taz-mix__art-loading[hidden]{display:none}.taz-mix__main{min-width:0;display:grid;gap:7px}.taz-mix__title-row{display:flex;align-items:start;justify-content:space-between;gap:8px}.taz-mix__track{min-width:0;display:grid;gap:2px}.taz-mix__track span{color:var(--mix-blue);font-size:8px;font-weight:850;letter-spacing:.16em}.taz-mix__track strong{overflow:hidden;color:#edf3ff;font-size:12px;line-height:1.35;text-overflow:ellipsis;white-space:nowrap;transition:opacity .18s,transform .18s}.taz-mix__track strong.is-changing{opacity:0;transform:translateY(3px)}.taz-mix__window-controls{display:flex;gap:4px}.taz-mix button{font:inherit}.taz-mix__window-controls button,.taz-mix__transport button,.taz-mix__volume button{display:grid;place-items:center;border:1px solid rgba(135,169,236,.17);background:rgba(255,255,255,.025);color:white;cursor:pointer;transition:transform .18s,border-color .18s,background .18s}.taz-mix__window-controls button{width:27px;height:27px;border-radius:8px}.taz-mix__window-controls button:hover,.taz-mix__transport button:hover,.taz-mix__volume button:hover{transform:translateY(-1px);border-color:rgba(91,200,255,.55);background:rgba(91,200,255,.08)}.taz-mix__progress-row{display:grid;grid-template-columns:27px 1fr 27px;align-items:center;gap:6px;color:var(--mix-muted);font-size:8px;font-variant-numeric:tabular-nums}.taz-mix input[type='range']{width:100%;height:4px;margin:0;accent-color:var(--mix-blue);cursor:pointer}.taz-mix__controls{display:flex;align-items:center;justify-content:space-between;gap:10px}.taz-mix__transport{display:flex;align-items:center;gap:5px}.taz-mix__transport button{width:31px;height:31px;border-radius:9px;font-size:17px}.taz-mix__transport .taz-mix__play{width:38px;background:linear-gradient(135deg,#438eff,#7951dd);border-color:transparent;box-shadow:0 6px 18px rgba(79,112,255,.25);font-size:11px}.taz-mix__volume{display:grid;grid-template-columns:25px minmax(54px,1fr) 27px;align-items:center;gap:5px;min-width:130px}.taz-mix__volume button{width:25px;height:25px;border-radius:8px;font-size:12px}.taz-mix__volume output{color:#cbd7ea;font-size:8px;text-align:right}.taz-mix__footer{display:flex;justify-content:space-between;gap:8px;color:var(--mix-muted);font-size:8px}.taz-mix__footer span{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.taz-mix__footer a{flex:none;color:var(--mix-blue);font-weight:800;text-decoration:none}.taz-mix__enable,.taz-mix__error{padding:7px;border:1px solid rgba(91,200,255,.2);border-radius:8px;background:rgba(91,200,255,.055)}.taz-mix__enable[hidden],.taz-mix__error[hidden]{display:none}.taz-mix__enable p,.taz-mix__error p{margin:0 0 6px;color:var(--mix-muted);font-size:8px}.taz-mix__enable button,.taz-mix__error a{display:block;width:100%;padding:6px;border:0;border-radius:6px;background:linear-gradient(135deg,#3f91ff,#7655df);color:white;font-size:8px;font-weight:850;text-align:center;text-decoration:none;cursor:pointer}.taz-mix__error strong{font-size:9px}.taz-mix__collapsed{position:relative;width:58px;height:58px;margin-left:auto;padding:0;overflow:hidden;border:1px solid rgba(91,200,255,.48);border-radius:17px;background:#080c1a;box-shadow:inset 0 1px rgba(255,255,255,.08),0 0 28px rgba(91,130,255,.22);cursor:pointer}.taz-mix__collapsed img{width:100%;height:100%;object-fit:cover}.taz-mix__collapsed[hidden]{display:none}.taz-mix__collapsed::after{content:'';position:absolute;inset:0;background:linear-gradient(145deg,transparent,rgba(3,6,14,.68))}.taz-mix__equalizer{position:absolute;z-index:3;right:8px;bottom:7px;display:flex;align-items:end;gap:2px;height:11px}.taz-mix__equalizer--art{right:7px;bottom:6px}.taz-mix__equalizer i{width:2px;height:4px;border-radius:2px;background:var(--mix-cyan);animation:taz-mix-eq .65s ease-in-out infinite alternate;animation-play-state:paused}.taz-mix.is-playing .taz-mix__equalizer i{animation-play-state:running}.taz-mix__equalizer i:nth-child(2){height:9px;animation-delay:-.2s}.taz-mix__equalizer i:nth-child(3){height:6px;animation-delay:-.4s}.taz-mix.is-minimized{width:58px}.taz-mix.is-minimized .taz-mix__expanded{display:none}.taz-mix button:focus-visible,.taz-mix a:focus-visible,.taz-mix input:focus-visible{outline:2px solid var(--mix-cyan);outline-offset:2px}@keyframes taz-mix-spin{to{transform:rotate(360deg)}}@keyframes taz-mix-eq{to{height:11px}}@media(max-width:520px){.taz-mix{right:8px;bottom:max(8px,env(safe-area-inset-bottom));width:calc(100vw - 16px)}.taz-mix__expanded{grid-template-columns:64px minmax(0,1fr);gap:9px;padding:9px;border-radius:15px}.taz-mix__art{width:64px;height:64px}.taz-mix__title-row{align-items:center}.taz-mix__track strong{font-size:10px}.taz-mix__progress-row{grid-template-columns:24px 1fr 24px}.taz-mix__controls{gap:6px}.taz-mix__transport{gap:3px}.taz-mix__transport button{width:29px;height:29px}.taz-mix__transport .taz-mix__play{width:34px}.taz-mix__volume{grid-template-columns:23px minmax(42px,1fr);min-width:84px}.taz-mix__volume output{display:none}.taz-mix__footer{display:none}.taz-mix__window-controls button:last-child{display:none}}@media(max-width:350px){.taz-mix__expanded{grid-template-columns:54px minmax(0,1fr)}.taz-mix__art{width:54px;height:54px}.taz-mix__volume{min-width:65px}.taz-mix__volume button{display:none}}@media(prefers-reduced-motion:reduce){.taz-mix *{animation-duration:.01ms!important;animation-iteration-count:1!important;transition-duration:.01ms!important}.taz-mix__equalizer i{animation:none!important}}
</style>

<script is:inline>
  (() => {
    const root = document.getElementById('taz-mix');
    if (!root || root.dataset.initialized === 'true') return;
    root.dataset.initialized = 'true';

    const PLAYLIST_ID = 'RDk04tX2fvh0o';
    const STORAGE = {
      track: 'tazMixTrack', time: 'tazMixCurrentTime', playing: 'tazMixPlaying', volume: 'tazMixVolume',
      minimized: 'tazMixMinimized', enabled: 'tazMixEnabled', muted: 'tazMixMuted'
    };
    const numberFromStorage = (key, fallback) => {
      const rawValue = localStorage.getItem(key);
      if (rawValue === null || rawValue === '') return fallback;
      const value = Number(rawValue);
      return Number.isFinite(value) ? value : fallback;
    };
    const formatTime = (seconds) => {
      const safeSeconds = Math.max(0, Math.floor(Number(seconds) || 0));
      return `${Math.floor(safeSeconds / 60)}:${String(safeSeconds % 60).padStart(2, '0')}`;
    };

    const hadSavedPlaying = localStorage.getItem(STORAGE.playing) !== null;
    let volume = Math.min(100, Math.max(0, numberFromStorage(STORAGE.volume, 25)));
    let minimized = localStorage.getItem(STORAGE.minimized) === 'true';
    let enabled = localStorage.getItem(STORAGE.enabled) === 'true';
    let playing = localStorage.getItem(STORAGE.playing) === 'true';
    let muted = localStorage.getItem(STORAGE.muted) === 'true';
    let player = null;
    let ready = false;
    let seeking = false;
    let errorSkips = 0;
    let loadTimeout = null;

    const expanded = root.querySelector('.taz-mix__expanded');
    const collapsed = root.querySelector('.taz-mix__collapsed');
    const loading = root.querySelector('[data-player-loading]');
    const enablePanel = root.querySelector('[data-enable-panel]');
    const enableMessage = root.querySelector('[data-enable-message]');
    const errorPanel = root.querySelector('[data-error-panel]');
    const title = root.querySelector('[data-track-title]');
    const thumbnails = root.querySelectorAll('[data-thumbnail], [data-thumbnail-mini]');
    const status = root.querySelector('[data-status]');
    const volumeInput = root.querySelector('[data-volume]');
    const volumeValue = root.querySelector('[data-volume-value]');
    const progress = root.querySelector('[data-progress]');
    const currentTime = root.querySelector('[data-current-time]');
    const duration = root.querySelector('[data-duration]');
    const playSymbol = root.querySelector('[data-play-symbol]');
    const muteSymbol = root.querySelector('[data-mute-symbol]');

    const setStatus = (message) => { if (status) status.textContent = message; };
    const setMinimized = (value) => {
      minimized = value;
      localStorage.setItem(STORAGE.minimized, String(value));
      root.classList.toggle('is-minimized', value);
      expanded.hidden = value;
      collapsed.hidden = !value;
    };
    const setPlaying = (value) => {
      playing = value;
      localStorage.setItem(STORAGE.playing, String(value));
      root.classList.toggle('is-playing', value);
      if (playSymbol) playSymbol.textContent = value ? 'Ⅱ' : '▶';
      root.querySelector('[data-action="play"]')?.setAttribute('aria-label', value ? 'Pause Taz’s Mix' : 'Play Taz’s Mix');
      setStatus(value ? 'Playing across the site' : 'Taz’s Mix is paused');
    };
    const updateVolume = (value, save = true) => {
      volume = Math.min(100, Math.max(0, Number(value)));
      if (volumeInput) { volumeInput.value = String(volume); volumeInput.setAttribute('aria-label', `Taz’s Mix volume: ${volume} percent`); }
      if (volumeValue) volumeValue.textContent = `${volume}%`;
      if (save) localStorage.setItem(STORAGE.volume, String(volume));
      if (ready) { player.setVolume(volume); if (volume > 0 && player.isMuted()) { player.unMute(); muted = false; } }
    };
    const updateTrack = () => {
      if (!ready) return;
      const data = player.getVideoData?.() || {};
      if (title) {
        title.classList.add('is-changing');
        window.setTimeout(() => { title.textContent = data.title || 'Taz’s Mix'; title.classList.remove('is-changing'); }, 120);
      }
      if (data.video_id) thumbnails.forEach((thumbnail) => { thumbnail.src = `https://i.ytimg.com/vi/${data.video_id}/mqdefault.jpg`; });
    };
    const updateProgress = () => {
      if (!ready || seeking) return;
      const elapsed = Number(player.getCurrentTime?.()) || 0;
      const total = Number(player.getDuration?.()) || 0;
      if (progress) progress.value = total > 0 ? String(Math.round((elapsed / total) * 1000)) : '0';
      if (currentTime) currentTime.textContent = formatTime(elapsed);
      if (duration) duration.textContent = formatTime(total);
    };
    const saveState = () => {
      if (!ready) return;
      const track = Number(player.getPlaylistIndex?.());
      const time = Number(player.getCurrentTime?.());
      if (Number.isFinite(track) && track >= 0) localStorage.setItem(STORAGE.track, String(track));
      if (Number.isFinite(time)) localStorage.setItem(STORAGE.time, String(Math.floor(time)));
      localStorage.setItem(STORAGE.playing, String(playing));
      localStorage.setItem(STORAGE.enabled, String(enabled));
      localStorage.setItem(STORAGE.muted, String(ready ? player.isMuted() : muted));
    };
    const showEnable = (message = 'Your browser paused autoplay until you interact.') => {
      if (enableMessage) enableMessage.textContent = message;
      enablePanel.hidden = false;
      setPlaying(false);
      setStatus('Press play to continue');
    };
    const showError = () => {
      clearTimeout(loadTimeout);
      loading.hidden = true;
      enablePanel.hidden = true;
      errorPanel.hidden = false;
      setPlaying(false);
      setStatus('Taz’s Mix is unavailable');
    };
    const startPlayback = () => {
      if (!ready) return;
      enabled = true;
      localStorage.setItem(STORAGE.enabled, 'true');
      enablePanel.hidden = true;
      errorPanel.hidden = true;
      player.setVolume(volume);
      player.playVideo();
    };
    const restorePlaylist = () => {
      const index = Math.max(0, numberFromStorage(STORAGE.track, 0));
      const startSeconds = Math.max(0, numberFromStorage(STORAGE.time, 0));
      const shouldAutoplay = !minimized && (playing || !hadSavedPlaying);
      const options = { list: PLAYLIST_ID, listType: 'playlist', index, startSeconds, suggestedQuality: 'small' };
      if (shouldAutoplay) player.loadPlaylist(options); else player.cuePlaylist(options);
      player.setVolume(volume);
      if (muted) player.mute();
      return shouldAutoplay;
    };

    setMinimized(minimized);
    setPlaying(playing);
    updateVolume(volume, false);
    if (muteSymbol) muteSymbol.textContent = muted ? '○' : '◕';

    root.addEventListener('click', (event) => {
      const button = event.target.closest('[data-action]');
      if (!button) return;
      const action = button.dataset.action;
      if (action === 'minimize') setMinimized(true);
      if (action === 'enable') startPlayback();
      if (action === 'play' && ready) playing ? player.pauseVideo() : startPlayback();
      if (action === 'previous' && ready) { errorSkips = 0; player.previousVideo(); }
      if (action === 'next' && ready) { errorSkips = 0; player.nextVideo(); }
      if (action === 'stop' && ready) { player.stopVideo(); setPlaying(false); localStorage.setItem(STORAGE.time, '0'); }
      if (action === 'mute' && ready) {
        muted = !player.isMuted();
        muted ? player.mute() : player.unMute();
        localStorage.setItem(STORAGE.muted, String(muted));
        if (muteSymbol) muteSymbol.textContent = muted ? '○' : '◕';
        button.setAttribute('aria-label', muted ? 'Unmute Taz’s Mix' : 'Mute Taz’s Mix');
      }
    });
    collapsed.addEventListener('click', () => setMinimized(false));
    volumeInput?.addEventListener('input', (event) => updateVolume(event.target.value));
    progress?.addEventListener('pointerdown', () => { seeking = true; });
    progress?.addEventListener('input', () => {
      if (!ready) return;
      const total = Number(player.getDuration?.()) || 0;
      const target = total * (Number(progress.value) / 1000);
      if (currentTime) currentTime.textContent = formatTime(target);
    });
    progress?.addEventListener('change', () => {
      if (!ready) return;
      const total = Number(player.getDuration?.()) || 0;
      player.seekTo(total * (Number(progress.value) / 1000), true);
      seeking = false;
      saveState();
    });

    document.addEventListener('tazmix:pause-request', () => {
      if (!ready || !playing) return;
      player.pauseVideo();
      saveState();
    });

    window.addEventListener('pagehide', saveState);
    document.addEventListener('astro:before-swap', saveState);
    document.addEventListener('visibilitychange', () => { if (document.visibilityState === 'hidden') saveState(); });
    window.setInterval(() => { updateProgress(); if (playing) saveState(); }, 1000);

    window.tazMixCreatePlayer = () => {
      if (player || !window.YT?.Player) return;
      player = new window.YT.Player('taz-mix-youtube', {
        width: 200,
        height: 200,
        host: 'https://www.youtube-nocookie.com',
        playerVars: { autoplay: 1, controls: 0, disablekb: 1, enablejsapi: 1, playsinline: 1, listType: 'playlist', list: PLAYLIST_ID, origin: window.location.origin, rel: 0 },
        events: {
          onReady: (event) => {
            ready = true;
            clearTimeout(loadTimeout);
            loading.hidden = true;
            event.target.getIframe()?.setAttribute('allow', 'autoplay; encrypted-media');
            updateVolume(volume, false);
            const shouldAutoplay = restorePlaylist();
            window.setTimeout(() => {
              updateTrack(); updateProgress();
              if (shouldAutoplay) {
                player.playVideo();
                window.setTimeout(() => { if (player?.getPlayerState?.() !== 1) showEnable('Autoplay was blocked. Press play to resume from your saved track.'); }, 1600);
              }
            }, 400);
          },
          onStateChange: (event) => {
            const state = event.data;
            if (state === window.YT.PlayerState.PLAYING) { enabled = true; localStorage.setItem(STORAGE.enabled, 'true'); enablePanel.hidden = true; errorPanel.hidden = true; errorSkips = 0; setPlaying(true); updateTrack(); updateProgress(); }
            if (state === window.YT.PlayerState.PAUSED || state === window.YT.PlayerState.CUED) setPlaying(false);
            if (state === window.YT.PlayerState.ENDED) { setPlaying(false); player.nextVideo(); }
          },
          onAutoplayBlocked: () => showEnable('Autoplay was blocked. Press play to resume from your saved track.'),
          onError: () => {
            errorSkips += 1;
            if (errorSkips <= 5) { setStatus('Skipping an unavailable track'); window.setTimeout(() => player.nextVideo(), 350); }
            else showError();
          }
        }
      });
    };

    if (window.YT?.Player) window.tazMixCreatePlayer();
    else if (!document.querySelector('script[data-taz-mix-api]')) {
      const previousReady = window.onYouTubeIframeAPIReady;
      window.onYouTubeIframeAPIReady = () => { previousReady?.(); window.tazMixCreatePlayer?.(); };
      const script = document.createElement('script');
      script.src = 'https://www.youtube.com/iframe_api';
      script.async = true;
      script.dataset.tazMixApi = 'true';
      script.onerror = showError;
      document.head.appendChild(script);
    }
    loadTimeout = window.setTimeout(() => { if (!ready) showError(); }, 12000);
  })();
</script>
