---
import PlatformIcon from '../brand/PlatformIcon.astro';
import { siteConfig } from '../../config/site';
---
<div class="tiktok-dashboard" data-tiktok-dashboard>
  <article class="tiktok-profile"><div class="tiktok-profile-top"><img data-tiktok-image src="/images/brand/taz-elite-logo-256.webp" alt="Taz Elite TikTok profile fallback" width="96" height="96" /><div><p><PlatformIcon name="tiktok" size={16} /> TIKTOK CREATOR</p><h2 data-tiktok-name>Taz Elite Plays</h2><span data-tiktok-username>@tazeliteplays</span></div><a href={siteConfig.socials.tiktok} target="_blank" rel="noopener noreferrer">Follow</a></div><div class="tiktok-stats"><div><span>Followers</span><strong data-tiktok-followers>Loading…</strong></div><div><span>Total likes</span><strong data-tiktok-likes>Loading…</strong></div><div><span>Live status</span><strong data-tiktok-live>Checking…</strong></div></div><div class="tiktok-notice" data-tiktok-notice>Loading authorized TikTok information…</div></article>
  <section class="tiktok-post-panel"><header><div><span>TOP VERIFIED POSTS</span><h2>Most-viewed connected content</h2></div><button type="button" data-tiktok-retry>Retry data</button></header><div class="tiktok-posts" data-tiktok-posts><div class="integration-skeleton"><i></i><i></i><i></i></div></div></section>
</div>
<style>
  .tiktok-dashboard{display:grid;grid-template-columns:minmax(280px,.8fr) minmax(0,1.2fr);gap:1rem}.tiktok-profile,.tiktok-post-panel{min-width:0;padding:1.25rem;border:1px solid rgba(255,79,129,.23);border-radius:18px;background:linear-gradient(145deg,rgba(54,16,37,.18),rgba(7,12,24,.82))}.tiktok-profile-top{display:grid;grid-template-columns:auto minmax(0,1fr) auto;gap:.8rem;align-items:center}.tiktok-profile-top img{width:74px;height:74px;object-fit:cover;border-radius:20px;border:2px solid rgba(74,233,221,.45)}.tiktok-profile-top p{display:flex;align-items:center;gap:.35rem;margin:0;color:#77f3e8;font-size:.64rem;font-weight:800;letter-spacing:.12em}.tiktok-profile-top h2{margin:.3rem 0 0;font-family:'Space Grotesk',sans-serif}.tiktok-profile-top span{color:#9da9bf;font-size:.75rem}.tiktok-profile-top>a,.tiktok-post-panel button{min-height:42px;padding:.65rem .8rem;border:1px solid rgba(255,79,129,.34);border-radius:9px;background:rgba(255,79,129,.1);color:white;text-decoration:none;cursor:pointer}.tiktok-stats{display:grid;grid-template-columns:repeat(3,1fr);gap:.55rem;margin-top:1rem}.tiktok-stats div{padding:.8rem;border:1px solid rgba(255,255,255,.08);border-radius:11px}.tiktok-stats span{display:block;color:#929db0;font-size:.65rem}.tiktok-stats strong{display:block;margin-top:.25rem;overflow-wrap:anywhere}.tiktok-notice{margin-top:1rem;color:#a6b1c3;font-size:.74rem;line-height:1.6}.tiktok-notice.error{padding:.8rem;border:1px solid rgba(255,90,126,.27);border-radius:10px;background:rgba(85,17,38,.15)}.tiktok-post-panel header{display:flex;justify-content:space-between;gap:1rem;margin-bottom:1rem}.tiktok-post-panel header span{color:#77f3e8;font-size:.64rem;font-weight:800;letter-spacing:.12em}.tiktok-post-panel h2{margin:.35rem 0 0;font-family:'Space Grotesk',sans-serif;font-size:1.35rem}.tiktok-posts{display:grid;grid-template-columns:repeat(3,1fr);gap:.65rem}.tiktok-post{min-width:0;overflow:hidden;border:1px solid rgba(255,255,255,.08);border-radius:11px;background:rgba(2,5,12,.38);text-decoration:none}.tiktok-post img{width:100%;aspect-ratio:9/12;object-fit:cover;background:#101827}.tiktok-post div{padding:.7rem}.tiktok-post strong{display:block;color:white;font-size:.78rem;line-height:1.4}.tiktok-post span{display:block;margin-top:.45rem;color:#929db0;font-size:.68rem}.integration-skeleton{grid-column:1/-1;display:grid;grid-template-columns:repeat(3,1fr);gap:.65rem}.integration-skeleton i{display:block;height:220px;border-radius:11px;background:linear-gradient(90deg,#151c2d,#2b354c,#151c2d);background-size:200%;animation:tiktok-shimmer 1.4s infinite}@keyframes tiktok-shimmer{to{background-position:-200%}}@media(max-width:850px){.tiktok-dashboard{grid-template-columns:1fr}}@media(max-width:540px){.tiktok-profile,.tiktok-post-panel{padding:.9rem}.tiktok-profile-top{grid-template-columns:58px minmax(0,1fr)}.tiktok-profile-top img{width:58px;height:58px}.tiktok-profile-top>a{grid-column:1/-1;text-align:center}.tiktok-stats{grid-template-columns:1fr 1fr}.tiktok-stats div:last-child{grid-column:1/-1}.tiktok-posts,.integration-skeleton{grid-template-columns:1fr}.tiktok-post{display:grid;grid-template-columns:100px 1fr}.tiktok-post img{height:100%;aspect-ratio:1/1}.tiktok-post-panel header{align-items:flex-start;flex-direction:column}}
</style>
<script>
  import { errorLabel, fetchIntegration, formatCount } from '../../scripts/live-data';
  interface TikTokData { displayName: string; username: string; image: string | null; followers: number; likes: number | null; isLive: boolean | null; liveStatusAvailable: boolean; cache: { source: 'tiktok-api' | 'manual'; fetchedAt: string; stale: boolean }; posts: Array<{ title: string; thumbnail: string | null; views: number; likes: number; url: string }> }
  document.querySelectorAll<HTMLElement>('[data-tiktok-dashboard]').forEach((root) => {
    const set = (selector: string, value: string) => { const element = root.querySelector<HTMLElement>(selector); if (element) element.textContent = value; };
    const load = async () => {
      const notice = root.querySelector<HTMLElement>('[data-tiktok-notice]'); if (notice) { notice.classList.remove('error'); notice.textContent = 'Loading authorized TikTok information…'; }
      try {
        const result = await fetchIntegration<TikTokData>('/.netlify/functions/tiktok-profile'); const data = result.data; set('[data-tiktok-name]', data.displayName || 'Taz Elite Plays'); set('[data-tiktok-username]', `@${data.username || 'tazeliteplays'}`); set('[data-tiktok-followers]', formatCount(data.followers)); set('[data-tiktok-likes]', formatCount(data.likes)); set('[data-tiktok-live]', data.liveStatusAvailable ? (data.isLive ? 'LIVE NOW' : 'Offline') : 'Not provided by API'); const image = root.querySelector<HTMLImageElement>('[data-tiktok-image]'); if (image && data.image) { image.src = data.image; image.onerror = () => { image.src = '/images/brand/taz-elite-logo-256.webp'; }; } if (notice) { const updated = new Date(data.cache.fetchedAt).toLocaleString([], { month: 'short', day: 'numeric', hour: 'numeric', minute: '2-digit' }); const source = data.cache.source === 'manual' ? 'Manually maintained follower count' : 'TikTok profile data'; notice.textContent = `${source} saved ${updated}${data.cache.stale ? ' · showing the last successful value' : ' · refreshed at most once per day'}. TikTok does not provide live status through this connection.`; }
        const posts = root.querySelector<HTMLElement>('[data-tiktok-posts]'); if (posts) { posts.replaceChildren(...data.posts.map((post) => { const link = document.createElement('a'); link.className = 'tiktok-post'; link.href = post.url; link.target = '_blank'; link.rel = 'noopener noreferrer'; const thumbnail = document.createElement('img'); thumbnail.src = post.thumbnail || '/images/brand/taz-elite-logo-512.webp'; thumbnail.alt = `Thumbnail for ${post.title}`; thumbnail.loading = 'lazy'; thumbnail.onerror = () => { thumbnail.src = '/images/brand/taz-elite-logo-512.webp'; }; const copy = document.createElement('div'); const title = document.createElement('strong'); title.textContent = post.title; const meta = document.createElement('span'); meta.textContent = `${formatCount(post.views)} views · ${formatCount(post.likes)} likes`; copy.append(title, meta); link.append(thumbnail, copy); return link; })); if (!data.posts.length) { const empty = document.createElement('div'); empty.className = 'tiktok-notice'; empty.textContent = data.cache.source === 'manual' ? 'Recent posts require TikTok authorization. The follower count remains available from the saved manual value.' : 'No authorized TikTok posts were returned. Visit the profile for the latest content.'; posts.append(empty); } }
      } catch (requestError) { const details = requestError as { code?: string; message?: string }; set('[data-tiktok-followers]', 'Unavailable'); set('[data-tiktok-likes]', 'Unavailable'); set('[data-tiktok-live]', 'Unavailable'); if (notice) { notice.classList.add('error'); notice.textContent = `${errorLabel(details.code || '')}: ${details.message || 'Some TikTok statistics are unavailable through the current connection. Visit TikTok for the latest information.'}`; } const posts = root.querySelector<HTMLElement>('[data-tiktok-posts]'); if (posts) { posts.innerHTML = ''; const empty = document.createElement('div'); empty.className = 'tiktok-notice error'; empty.textContent = 'Verified TikTok post data is unavailable. No placeholder statistics are shown.'; posts.append(empty); } }
    };
    root.querySelector('[data-tiktok-retry]')?.addEventListener('click', load); load();
  });
</script>
