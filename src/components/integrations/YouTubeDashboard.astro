---
import PlatformIcon from '../brand/PlatformIcon.astro';
import { siteConfig } from '../../config/site';
---
<div class="youtube-dashboard" data-youtube-dashboard>
  <article class="youtube-channel-panel">
    <div class="youtube-profile"><img data-youtube-image src="/images/brand/taz-elite-logo-256.webp" alt="Taz Elite YouTube channel fallback" width="96" height="96" /><div><p><PlatformIcon name="youtube" size={16} /> YOUTUBE CHANNEL</p><h2 data-youtube-name>TazElite Plays</h2><span>@tazelite-plays</span></div><a href={siteConfig.socials.youtube} target="_blank" rel="noopener noreferrer">Subscribe</a></div>
    <p data-youtube-description>Loading official YouTube channel information…</p>
    <div class="youtube-stats"><div><span>Subscribers</span><strong data-youtube-subscribers>Loading…</strong></div><div><span>Videos</span><strong data-youtube-count>Loading…</strong></div><div><span>Total views</span><strong data-youtube-views>Loading…</strong></div><div><span>Live status</span><strong data-youtube-live>Checking…</strong></div></div>
    <div class="youtube-notice" data-youtube-channel-notice></div>
  </article>
  <section class="youtube-videos-panel"><header><div><span>RECENT UPLOADS</span><h2>Latest from TazElite Plays</h2></div><button type="button" data-youtube-retry>Retry data</button></header><div class="youtube-video-list" data-youtube-videos><div class="integration-skeleton"><i></i><i></i><i></i></div></div><p class="youtube-source" data-youtube-source></p></section>
</div>
<style>
  .youtube-dashboard{display:grid;grid-template-columns:minmax(280px,.8fr) minmax(0,1.2fr);gap:1rem}.youtube-channel-panel,.youtube-videos-panel{min-width:0;padding:1.25rem;border:1px solid rgba(255,69,69,.22);border-radius:18px;background:linear-gradient(145deg,rgba(72,16,26,.16),rgba(8,12,25,.8))}.youtube-profile{display:grid;grid-template-columns:auto minmax(0,1fr) auto;gap:.8rem;align-items:center}.youtube-profile img{width:76px;height:76px;object-fit:cover;border-radius:18px;border:2px solid rgba(255,69,69,.45)}.youtube-profile p{display:flex;align-items:center;gap:.35rem;margin:0;color:#ff8d8d;font-size:.64rem;font-weight:800;letter-spacing:.12em}.youtube-profile h2{margin:.3rem 0 0;font-family:'Space Grotesk',sans-serif}.youtube-profile span{color:#9da9bf;font-size:.76rem}.youtube-profile>a,.youtube-videos-panel button{min-height:42px;padding:.65rem .8rem;border:1px solid rgba(255,69,69,.32);border-radius:9px;background:rgba(255,69,69,.1);color:white;text-decoration:none;cursor:pointer}.youtube-channel-panel>p{color:#aab5c8;line-height:1.65}.youtube-stats{display:grid;grid-template-columns:repeat(2,1fr);gap:.6rem}.youtube-stats div{padding:.8rem;border:1px solid rgba(255,255,255,.08);border-radius:11px}.youtube-stats span{display:block;color:#8f9bb0;font-size:.66rem}.youtube-stats strong{display:block;margin-top:.25rem;overflow-wrap:anywhere}.youtube-notice,.youtube-source{margin-top:.8rem;color:#a4afc1;font-size:.72rem;line-height:1.55}.youtube-notice.error{padding:.75rem;border:1px solid rgba(255,105,130,.25);border-radius:10px;background:rgba(85,17,35,.15)}.youtube-videos-panel header{display:flex;align-items:center;justify-content:space-between;gap:1rem;margin-bottom:1rem}.youtube-videos-panel header span{color:#ff8888;font-size:.65rem;font-weight:800;letter-spacing:.13em}.youtube-videos-panel h2{margin:.35rem 0 0;font-family:'Space Grotesk',sans-serif;font-size:1.35rem}.youtube-video-list{display:grid;gap:.75rem}.youtube-video{display:grid;grid-template-columns:160px minmax(0,1fr);gap:.85rem;padding:.75rem;border:1px solid rgba(255,255,255,.08);border-radius:12px;background:rgba(2,5,12,.35);text-decoration:none}.youtube-video img{width:100%;aspect-ratio:16/9;object-fit:cover;border-radius:8px;background:#111827}.youtube-video strong{display:block;color:white;line-height:1.4}.youtube-video span{display:block;margin-top:.5rem;color:#939eb1;font-size:.72rem}.integration-skeleton{display:grid;gap:.7rem}.integration-skeleton i{display:block;height:70px;border-radius:11px;background:linear-gradient(90deg,#151c2d,#2b354c,#151c2d);background-size:200%;animation:integration-shimmer 1.4s infinite}@keyframes integration-shimmer{to{background-position:-200%}}@media(max-width:820px){.youtube-dashboard{grid-template-columns:1fr}}@media(max-width:480px){.youtube-channel-panel,.youtube-videos-panel{padding:.9rem}.youtube-profile{grid-template-columns:58px minmax(0,1fr)}.youtube-profile img{width:58px;height:58px}.youtube-profile>a{grid-column:1/-1;text-align:center}.youtube-video{grid-template-columns:1fr}.youtube-stats{grid-template-columns:1fr 1fr}.youtube-videos-panel header{align-items:flex-start;flex-direction:column}}
</style>
<script>
  import { errorLabel, fetchIntegration, formatCount, formatDate } from '../../scripts/live-data';
  interface ChannelData { name: string; description: string; image: string; subscriberCount: number | null; subscriberCountHidden: boolean; videoCount: number; viewCount: number; }
  interface VideoData { items: Array<{ title: string; thumbnail: string; publishedAt: string; viewCount: number; duration: string | null; url: string }>; partial: boolean; source: string; unavailableFields?: string[]; }
  interface LiveData { isLive: boolean; title: string | null; url: string | null; }
  document.querySelectorAll<HTMLElement>('[data-youtube-dashboard]').forEach((root) => {
    const set = (selector: string, value: string) => { const element = root.querySelector<HTMLElement>(selector); if (element) element.textContent = value; };
    const load = async () => {
      set('[data-youtube-channel-notice]', 'Loading official channel statistics…'); set('[data-youtube-source]', 'Loading recent videos…');
      const [channelResult, videoResult, liveResult] = await Promise.allSettled([
        fetchIntegration<ChannelData>('/.netlify/functions/youtube-channel'),
        fetchIntegration<VideoData>('/.netlify/functions/youtube-videos'),
        fetchIntegration<LiveData>('/.netlify/functions/youtube-live')
      ]);
      const notice = root.querySelector<HTMLElement>('[data-youtube-channel-notice]');
      if (channelResult.status === 'fulfilled') { const data = channelResult.value.data; set('[data-youtube-name]', data.name); set('[data-youtube-description]', data.description || 'Videos and live content from Taz Elite.'); set('[data-youtube-subscribers]', data.subscriberCountHidden ? 'Hidden' : formatCount(data.subscriberCount)); set('[data-youtube-count]', formatCount(data.videoCount)); set('[data-youtube-views]', formatCount(data.viewCount)); const image = root.querySelector<HTMLImageElement>('[data-youtube-image]'); if (image) { image.src = data.image; image.onerror = () => { image.src = '/images/brand/taz-elite-logo-256.webp'; }; } if (notice) { notice.classList.remove('error'); notice.textContent = `Statistics updated ${new Date(channelResult.value.updatedAt).toLocaleTimeString([], { hour: 'numeric', minute: '2-digit' })}.`; } }
      else { const reason = channelResult.reason as { code?: string; message?: string }; set('[data-youtube-subscribers]', 'Unavailable'); set('[data-youtube-count]', 'Unavailable'); set('[data-youtube-views]', 'Unavailable'); set('[data-youtube-description]', 'Official channel statistics are not currently connected. Recent uploads may still load below.'); if (notice) { notice.classList.add('error'); notice.textContent = `${errorLabel(reason.code || '')}: ${reason.message || 'YouTube channel information is temporarily unavailable.'}`; } }
      if (liveResult.status === 'fulfilled') { const live = liveResult.value.data; set('[data-youtube-live]', live.isLive ? 'LIVE NOW' : 'Offline'); const liveElement = root.querySelector<HTMLElement>('[data-youtube-live]'); if (liveElement && live.isLive && live.url) { const link = document.createElement('a'); link.href = live.url; link.target = '_blank'; link.rel = 'noopener noreferrer'; link.textContent = 'LIVE NOW ↗'; liveElement.replaceWith(link); } }
      else { const reason = liveResult.reason as { code?: string }; set('[data-youtube-live]', reason.code === 'MISSING_CONFIGURATION' ? 'Setup required' : 'Unavailable'); }
      const videos = root.querySelector<HTMLElement>('[data-youtube-videos]');
      if (videos && videoResult.status === 'fulfilled') { const data = videoResult.value.data; videos.replaceChildren(...data.items.slice(0,3).map((video) => { const link = document.createElement('a'); link.className = 'youtube-video'; link.href = video.url; link.target = '_blank'; link.rel = 'noopener noreferrer'; const image = document.createElement('img'); image.src = video.thumbnail || '/images/brand/taz-elite-logo-512.webp'; image.alt = `Thumbnail for ${video.title}`; image.loading = 'lazy'; image.onerror = () => { image.src = '/images/brand/taz-elite-logo-512.webp'; }; const copy = document.createElement('div'); const title = document.createElement('strong'); title.textContent = video.title; const meta = document.createElement('span'); meta.textContent = [formatDate(video.publishedAt), `${formatCount(video.viewCount)} views`, video.duration].filter(Boolean).join(' · '); copy.append(title, meta); link.append(image, copy); return link; })); set('[data-youtube-source]', data.partial ? `Recent uploads loaded from the ${data.source}. Some fields require the YouTube Data API key.` : `Recent uploads loaded from ${data.source}.`); }
      else if (videos) { const reason = videoResult.status === 'rejected' ? videoResult.reason as { code?: string; message?: string } : null; videos.innerHTML = ''; const box = document.createElement('div'); box.className = 'youtube-notice error'; box.textContent = `${errorLabel(reason?.code || '')}: ${reason?.message || 'Recent YouTube videos are temporarily unavailable.'}`; videos.append(box); set('[data-youtube-source]', 'Use the channel link above for the latest videos.'); }
    };
    root.querySelector('[data-youtube-retry]')?.addEventListener('click', load); load();
  });
</script>
