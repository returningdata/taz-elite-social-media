---
import { approvedPhotos } from '../../data/content';
interface Props { compact?: boolean; }
const { compact = false } = Astro.props;
---
<div class:list={['approved-gallery', { compact }]} data-approved-gallery>
  <div class:list={['photo-gallery', { compact }]}> 
    {approvedPhotos.map((photo, index) => (
      <button type="button" class:list={['photo-card', `photo-${index + 1}`]} data-reveal data-photo-src={photo.src} data-photo-alt={photo.alt} data-photo-post={photo.post} data-photo-date={photo.date} aria-label={`Open larger approved photo from ${photo.date}`}>
        <img
          src={`/.netlify/images?url=${photo.src}&w=720&fit=contain`}
          srcset={`/.netlify/images?url=${photo.src}&w=360&fit=contain 360w, /.netlify/images?url=${photo.src}&w=560&fit=contain 560w, /.netlify/images?url=${photo.src}&w=820&fit=contain 820w`}
          sizes="(max-width: 520px) 100vw, (max-width: 760px) 50vw, 33vw"
          alt={photo.alt}
          width="640"
          height="640"
          loading={index === 0 ? 'eager' : 'lazy'}
          decoding="async"
        />
        <span><strong>Approved photo</strong><small>{photo.date} · Open larger view</small></span>
      </button>
    ))}
  </div>
  <dialog class="photo-dialog" data-photo-dialog><button type="button" class="photo-dialog-close" data-photo-close aria-label="Close photo viewer">×</button><img data-dialog-image src="/images/brand/taz-elite-logo-512.webp" alt="Approved Taz photo" /><div><span data-dialog-date></span><a data-dialog-post href="#" target="_blank" rel="noopener noreferrer">View original Instagram post ↗</a></div></dialog>
</div>
<style>
  .photo-card{padding:0;color:white;text-align:left;cursor:pointer;background:linear-gradient(145deg,#0c1324,#050812)}.photo-card img{padding:.5rem;object-fit:contain!important;background:radial-gradient(circle at 50% 20%,rgba(91,200,255,.08),transparent 55%),#060a14;border-radius:inherit}.photo-dialog{width:min(92vw,760px);max-height:90dvh;padding:0;overflow:auto;border:1px solid rgba(110,231,255,.25);border-radius:18px;background:#070b16;color:white;box-shadow:0 28px 100px rgba(0,0,0,.7)}.photo-dialog::backdrop{background:rgba(1,3,8,.82);backdrop-filter:blur(8px)}.photo-dialog>img{display:block;width:100%;max-height:78dvh;padding:.75rem;object-fit:contain;background:#03050b}.photo-dialog>div{display:flex;justify-content:space-between;gap:1rem;padding:1rem;color:#9da9bf}.photo-dialog a{color:#6ef7e1}.photo-dialog-close{position:sticky;float:right;top:.6rem;right:.6rem;z-index:2;width:44px;height:44px;margin: .6rem .6rem -3.35rem 0;border:1px solid rgba(255,255,255,.2);border-radius:50%;background:rgba(3,6,14,.86);color:white;font-size:1.7rem;cursor:pointer}@media(max-width:520px){.photo-dialog>div{align-items:flex-start;flex-direction:column}}
</style>
<script>
  const initializePhotoGalleries = () => document.querySelectorAll<HTMLElement>('[data-approved-gallery]:not([data-initialized])').forEach((gallery) => {
    gallery.dataset.initialized = 'true';
    const dialog = gallery.querySelector<HTMLDialogElement>('[data-photo-dialog]'); const image = gallery.querySelector<HTMLImageElement>('[data-dialog-image]'); const date = gallery.querySelector<HTMLElement>('[data-dialog-date]'); const post = gallery.querySelector<HTMLAnchorElement>('[data-dialog-post]');
    gallery.querySelectorAll<HTMLImageElement>('.photo-card img').forEach((photo) => photo.addEventListener('error', () => { photo.src = '/images/brand/taz-elite-logo-512.webp'; }, { once: true }));
    gallery.querySelectorAll<HTMLButtonElement>('[data-photo-src]').forEach((button) => button.addEventListener('click', () => { if (!dialog || !image || !date || !post) return; image.src = button.dataset.photoSrc || '/images/brand/taz-elite-logo-512.webp'; image.alt = button.dataset.photoAlt || 'Approved Taz photo'; image.onerror = () => { image.src = '/images/brand/taz-elite-logo-512.webp'; }; date.textContent = button.dataset.photoDate || ''; post.href = button.dataset.photoPost || '#'; dialog.showModal(); }));
    gallery.querySelector('[data-photo-close]')?.addEventListener('click', () => dialog?.close()); dialog?.addEventListener('click', (event) => { if (event.target === dialog) dialog.close(); });
  });

  initializePhotoGalleries();
  document.addEventListener('astro:page-load', initializePhotoGalleries);
</script>
