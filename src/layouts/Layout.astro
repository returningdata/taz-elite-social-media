---
import '../../src/styles/globals.css';
import '@fontsource-variable/inter/wght.css';
import interWoff2 from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';

interface Props {
    title: string;
    description?: string;
}

const { title, description = "Gaming Content Creator & Community Builder - Stranger Things Season 5" } = Astro.props;
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <title>{title}</title>
        <meta name="description" content={description} />
        <meta name="viewport" content="width=device-width" />
        <meta name="generator" content={Astro.generator} />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="preload" as="font" type="font/woff2" href={interWoff2} crossorigin />

        <!-- Stranger Things style font (Benguiat-like) -->
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@700;900&display=swap" rel="stylesheet" />

        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:type" content="website" />
        <meta name="twitter:card" content="summary_large_image" />

        <style>
            /* Stranger Things Title Font */
            .stranger-things-title {
                font-family: 'Cinzel', Georgia, serif;
                font-weight: 900;
                color: #e50914;
                text-transform: uppercase;
                letter-spacing: 0.1em;
                text-shadow:
                    0 0 10px rgba(229, 9, 20, 0.9),
                    0 0 20px rgba(229, 9, 20, 0.7),
                    0 0 30px rgba(229, 9, 20, 0.5),
                    0 0 40px rgba(229, 9, 20, 0.3),
                    2px 2px 4px rgba(0, 0, 0, 0.8);
                animation: stranger-flicker 4s infinite alternate;
            }

            @keyframes stranger-flicker {
                0%, 18%, 22%, 25%, 53%, 57%, 100% {
                    opacity: 1;
                    text-shadow:
                        0 0 10px rgba(229, 9, 20, 0.9),
                        0 0 20px rgba(229, 9, 20, 0.7),
                        0 0 30px rgba(229, 9, 20, 0.5),
                        0 0 40px rgba(229, 9, 20, 0.3);
                }
                20%, 24%, 55% {
                    opacity: 0.8;
                    text-shadow: 0 0 5px rgba(229, 9, 20, 0.5);
                }
            }
        </style>
    </head>
    <body class="antialiased text-white gradient-bg">
        <div class="upside-down-particles"></div>
        <div class="upside-down-overlay"></div>
        <div class="flex flex-col min-h-screen px-6 sm:px-12 relative z-10">
            <div class="flex flex-col w-full max-w-4xl mx-auto grow">
                <main class="grow py-8"><slot /></main>
            </div>
        </div>
        <!-- Dynamic theme loading and page tracking -->
        <script>
            // Generate or get visitor ID
            function getVisitorId() {
                let visitorId = localStorage.getItem('visitorId');
                if (!visitorId) {
                    visitorId = 'v_' + Math.random().toString(36).substr(2, 9) + Date.now().toString(36);
                    localStorage.setItem('visitorId', visitorId);
                }
                return visitorId;
            }

            // Track page view
            async function trackPageView() {
                try {
                    await fetch('/api/track', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ visitorId: getVisitorId() }),
                    });
                } catch (e) {
                    // Silently fail
                }
            }

            // Load and apply dynamic theme
            async function loadTheme() {
                try {
                    const response = await fetch('/api/admin/config');
                    if (!response.ok) return;

                    const config = await response.json();
                    if (!config?.theme) return;

                    const { primaryColor, accentColor, backgroundStart, backgroundEnd } = config.theme;

                    // Apply CSS custom properties
                    const root = document.documentElement;
                    if (primaryColor) {
                        root.style.setProperty('--dynamic-primary', primaryColor);
                        root.style.setProperty('--color-primary', primaryColor);
                    }
                    if (accentColor) {
                        root.style.setProperty('--dynamic-accent', accentColor);
                        root.style.setProperty('--color-accent', accentColor);
                    }
                    if (backgroundStart && backgroundEnd) {
                        root.style.setProperty('--dynamic-bg-start', backgroundStart);
                        root.style.setProperty('--dynamic-bg-end', backgroundEnd);
                    }

                    // Apply background gradient
                    const gradientBg = document.querySelector('.gradient-bg') as HTMLElement;
                    if (gradientBg && backgroundStart && backgroundEnd) {
                        gradientBg.style.background = `linear-gradient(180deg, ${backgroundStart} 0%, ${backgroundEnd} 30%, ${backgroundStart} 70%, #000000 100%)`;
                    }

                    // Apply title colors
                    document.querySelectorAll('.stranger-things-title').forEach((el) => {
                        const element = el as HTMLElement;
                        if (primaryColor) {
                            element.style.color = primaryColor;
                            element.style.textShadow = `0 0 10px ${primaryColor}E6, 0 0 20px ${primaryColor}B3, 0 0 30px ${primaryColor}80, 0 0 40px ${primaryColor}4D, 2px 2px 4px rgba(0, 0, 0, 0.8)`;
                        }
                    });

                    // Apply particle colors
                    const particles = document.querySelector('.upside-down-particles') as HTMLElement;
                    if (particles && primaryColor) {
                        particles.style.backgroundImage = `
                            radial-gradient(2px 2px at 20px 30px, ${primaryColor}4D, transparent),
                            radial-gradient(2px 2px at 40px 70px, rgba(255, 255, 255, 0.1), transparent),
                            radial-gradient(1px 1px at 90px 40px, ${primaryColor}33, transparent),
                            radial-gradient(2px 2px at 130px 80px, rgba(255, 255, 255, 0.1), transparent)
                        `;
                    }

                } catch (e) {
                    // Use default theme
                }
            }

            // Run on page load
            if (!window.location.pathname.startsWith('/admin')) {
                trackPageView();
            }
            loadTheme();
        </script>
    </body>
</html>
