    // Activity log helper
    function logActivity(action: string) {
        const log = document.getElementById('activity-log');
        if (!log) return;
        const existing = log.querySelector('.text-gray-500.text-center');
        if (existing) existing.remove();

        const item = document.createElement('div');
        item.className = 'activity-item';
        item.innerHTML = `
            <span class="time">${new Date().toLocaleTimeString()}</span>
            <span class="action">${action}</span>
        `;
        log.insertBefore(item, log.firstChild);

        // Keep only last 10 items
        while (log.children.length > 10) {
            log.removeChild(log.lastChild!);
        }
    }

    // Quick action: Export config
    function exportConfig() {
        const config = collectFormData();
        const blob = new Blob([JSON.stringify(config, null, 2)], { type: 'application/json' });
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = `tazelite-config-${new Date().toISOString().split('T')[0]}.json`;
        a.click();
        URL.revokeObjectURL(url);
        logActivity('Exported configuration');
    }

    // Quick action: Import config
    function importConfig(file: File) {
        const reader = new FileReader();
        reader.onload = (e) => {
            try {
                const config = JSON.parse(e.target?.result as string);
                currentConfig = config;
                populateForm(config);
                logActivity('Imported configuration');
                showToast('Configuration imported successfully!', 'success');
            } catch (error) {
                showToast('Failed to import configuration. Invalid file format.', 'error');
            }
        };
        reader.readAsText(file);
    }

    // Toast notification helper
    function showToast(message: string, type: 'success' | 'error' | 'info' = 'info') {
        const toast = document.createElement('div');
        toast.className = `fixed bottom-4 right-4 px-4 py-3 rounded-lg shadow-lg z-50 transition-all transform translate-y-2 opacity-0`;
        toast.style.background = type === 'success' ? '#22c55e' : type === 'error' ? '#ef4444' : '#3b82f6';
        toast.textContent = message;
        document.body.appendChild(toast);

        setTimeout(() => {
            toast.classList.remove('translate-y-2', 'opacity-0');
        }, 10);

        setTimeout(() => {
            toast.classList.add('translate-y-2', 'opacity-0');
            setTimeout(() => toast.remove(), 300);
        }, 3000);
    }

    // Copy site URL
    function copySiteUrl() {
        navigator.clipboard.writeText(window.location.origin);
        showToast('Site URL copied to clipboard!', 'success');
    }

    // Save config
    async function saveConfig() {
        const saveBtn = document.getElementById('save-config') as HTMLButtonElement;
        const saveStatus = document.getElementById('save-status');

        try {
            saveBtn.disabled = true;
            saveBtn.textContent = 'Saving...';

            const config = collectFormData();

            const response = await fetch('/api/admin/config', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(config),
            });

            if (response.ok) {
                if (saveStatus) {
                    saveStatus.textContent = 'Saved successfully!';
                    saveStatus.className = 'text-sm text-green-400';
                    setTimeout(() => {
                        saveStatus.textContent = '';
                    }, 3000);
                }
                logActivity('Saved configuration changes');
                currentConfig = config;
            } else {
                throw new Error('Save failed');
            }
        } catch (e) {
            console.error('Save error:', e);
            if (saveStatus) {
                saveStatus.textContent = 'Failed to save. Please try again.';
                saveStatus.className = 'text-sm text-red-400';
            }
        } finally {
            saveBtn.disabled = false;
            saveBtn.textContent = 'Save Changes';
        }
    }

    // Initialize
    async function init() {
        const session = await checkAuth();
        if (!session) return;

        const usernameEl = document.getElementById('admin-username');
        if (usernameEl) usernameEl.textContent = session.user.username;

        currentConfig = await loadConfig();
        if (currentConfig) {
            populateForm(currentConfig);
        }

        // Show content
        document.getElementById('loading')?.classList.add('hidden');
        document.getElementById('admin-content')?.classList.remove('hidden');

        // Load stats
        loadStats();
        setInterval(loadStats, 30000); // Refresh every 30 seconds

        // Tab switching
        document.querySelectorAll('.tab-btn').forEach(btn => {
            btn.addEventListener('click', () => {
                const tabName = btn.getAttribute('data-tab');
                if (!tabName) return;

                document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
                document.querySelectorAll('.tab-content').forEach(c => c.classList.add('hidden'));

                btn.classList.add('active');
                document.getElementById(`tab-${tabName}`)?.classList.remove('hidden');
            });
        });

        // Theme preset change
        document.getElementById('config-theme-name')?.addEventListener('change', (e) => {
            const themeName = (e.target as HTMLSelectElement).value;
            if (themeName !== 'custom' && themePresets[themeName]) {
                updateThemeColors(themePresets[themeName] as any);
                updateThemePreview();
            }
        });

        // Color input sync
        ['primaryColor', 'accentColor', 'backgroundStart', 'backgroundEnd'].forEach(colorName => {
            const colorPicker = document.getElementById(`config-theme-${colorName}`) as HTMLInputElement;
            const textInput = document.getElementById(`config-theme-${colorName}-text`) as HTMLInputElement;

            colorPicker?.addEventListener('input', () => {
                if (textInput) textInput.value = colorPicker.value;
                document.getElementById('config-theme-name')!.setAttribute('value', 'custom');
                (document.getElementById('config-theme-name') as HTMLSelectElement).value = 'custom';
                updateThemePreview();
            });

            textInput?.addEventListener('input', () => {
                if (colorPicker && /^#[0-9A-Fa-f]{6}$/.test(textInput.value)) {
                    colorPicker.value = textInput.value;
                    updateThemePreview();
                }
            });
        });

        // Save button
        document.getElementById('save-config')?.addEventListener('click', saveConfig);

        // Quick actions
        document.getElementById('action-export-config')?.addEventListener('click', exportConfig);
        document.getElementById('action-import-config')?.addEventListener('click', () => {
            document.getElementById('import-file-input')?.click();
        });
        document.getElementById('import-file-input')?.addEventListener('change', (e) => {
            const file = (e.target as HTMLInputElement).files?.[0];
            if (file) importConfig(file);
        });
        document.getElementById('action-copy-site-url')?.addEventListener('click', copySiteUrl);
        document.getElementById('action-reset-stats')?.addEventListener('click', () => {
            if (confirm('Are you sure you want to reset today\'s stats?')) {
                showToast('Stats reset feature coming soon', 'info');
            }
        });

        // Add item buttons
        document.getElementById('add-nav-link')?.addEventListener('click', addNavLink);
        document.getElementById('add-footer-link')?.addEventListener('click', addFooterLink);
        document.getElementById('add-pinned-message')?.addEventListener('click', addPinnedMessage);
        document.getElementById('add-special-stream')?.addEventListener('click', addSpecialStream);
        document.getElementById('add-redirect')?.addEventListener('click', addRedirect);

        // Backup buttons
        document.getElementById('backup-export')?.addEventListener('click', exportConfig);
        document.getElementById('backup-import')?.addEventListener('click', () => {
            document.getElementById('backup-file-input')?.click();
        });
        document.getElementById('backup-file-input')?.addEventListener('change', (e) => {
            const file = (e.target as HTMLInputElement).files?.[0];
            if (file) importConfig(file);
        });

        // Reset buttons
        document.getElementById('reset-theme')?.addEventListener('click', () => {
            if (confirm('Reset theme to default Stranger Things theme?')) {
                updateThemeColors(themePresets['stranger-things']);
                (document.getElementById('config-theme-name') as HTMLSelectElement).value = 'stranger-things';
                updateThemePreview();
                logActivity('Reset theme to default');
                showToast('Theme reset to default', 'success');
            }
        });
        document.getElementById('reset-content')?.addEventListener('click', () => {
            if (confirm('Reset all site content to defaults?')) {
                showToast('Content reset feature coming soon', 'info');
            }
        });
        document.getElementById('reset-all')?.addEventListener('click', () => {
            if (confirm('WARNING: This will reset ALL settings to defaults. Are you sure?')) {
                showToast('Full reset feature coming soon', 'info');
            }
        });

        // Analytics management
        document.getElementById('clear-today-stats')?.addEventListener('click', () => {
            if (confirm('Clear today\'s analytics data?')) {
                showToast('Stats cleared', 'success');
            }
        });
        document.getElementById('clear-all-stats')?.addEventListener('click', () => {
            if (confirm('WARNING: This will permanently delete ALL analytics data. Are you sure?')) {
                showToast('All stats cleared', 'success');
            }
        });

        // SEO preview updates
        ['config-seo-ogTitle', 'config-seo-ogDescription', 'config-seo-ogImage'].forEach(id => {
            document.getElementById(id)?.addEventListener('input', updateOgPreview);
        });

        // Log initial activity
        logActivity('Admin session started');

        // Update last modified info
        const infoLastModified = document.getElementById('info-last-modified');
        if (infoLastModified) {
            infoLastModified.textContent = new Date().toLocaleString();
        }

        // Initialize COD Loadouts management
        initLoadoutsManager();
    }

    // ========== COD LOADOUTS MANAGEMENT ==========
    interface LoadoutAttachment {
        slot: string;
        name: string;
        tuning?: string;
    }

    interface LoadoutData {
        id: string;
        weaponName: string;
        weaponSlug: string;
        weaponCategory: string;
        weaponImage: string;
        game: string;
        description: string;
        attachments: LoadoutAttachment[];
        perks: string[];
        equipment: { tactical: string; lethal: string };
        tags: string[];
        featured: boolean;
        createdAt: string;
        updatedAt: string;
    }

    let adminLoadouts: LoadoutData[] = [];

    async function fetchAdminLoadouts() {
        try {
            const resp = await fetch('/api/loadouts');
            if (resp.ok) {
                adminLoadouts = await resp.json();
            }
        } catch {
            adminLoadouts = [];
        }
        renderLoadoutsList();
    }

    function renderLoadoutsList() {
        const container = document.getElementById('loadouts-list');
        if (!container) return;

        if (adminLoadouts.length === 0) {
            container.innerHTML = '<div class="text-gray-500 text-center py-6 text-sm">No loadouts yet. Click "Add Loadout" to create one.</div>';
            return;
        }

        container.innerHTML = adminLoadouts.map(l => `
            <div class="loadout-list-item" data-id="${l.id}">
                <div class="loadout-list-thumb">
                    ${l.weaponImage ? `<img src="${l.weaponImage}" alt="${l.weaponName}">` : `<svg class="w-6 h-6 text-gray-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>`}
                </div>
                <div class="loadout-list-info">
                    <div class="loadout-list-name">${l.weaponName} ${l.featured ? '<span style="color: #fbbf24; font-size: 0.7rem;">FEATURED</span>' : ''}</div>
                    <div class="loadout-list-meta">${l.weaponCategory} &middot; ${l.game} &middot; ${l.attachments.length} attachments</div>
                </div>
                <div class="loadout-list-actions">
                    <button class="quick-action-btn text-xs" onclick="editLoadout('${l.id}')">Edit</button>
                    <button class="delete-btn" onclick="deleteLoadout('${l.id}', '${l.weaponName.replace(/'/g, "\\'")}')">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
                    </button>
                </div>
            </div>
        `).join('');
    }

    function showLoadoutForm(loadout?: LoadoutData) {
        const container = document.getElementById('loadout-form-container');
        const title = document.getElementById('loadout-form-title');
        container?.classList.remove('hidden');

        if (loadout) {
            if (title) title.textContent = 'Edit Loadout';
            (document.getElementById('loadout-edit-id') as HTMLInputElement).value = loadout.id;
            (document.getElementById('loadout-weaponName') as HTMLInputElement).value = loadout.weaponName;
            (document.getElementById('loadout-weaponCategory') as HTMLSelectElement).value = loadout.weaponCategory;
            (document.getElementById('loadout-game') as HTMLSelectElement).value = loadout.game;
            (document.getElementById('loadout-weaponImage') as HTMLInputElement).value = loadout.weaponImage;
            (document.getElementById('loadout-description') as HTMLTextAreaElement).value = loadout.description;
            (document.getElementById('loadout-perks') as HTMLInputElement).value = loadout.perks.join(', ');
            (document.getElementById('loadout-tactical') as HTMLInputElement).value = loadout.equipment?.tactical || '';
            (document.getElementById('loadout-lethal') as HTMLInputElement).value = loadout.equipment?.lethal || '';
            (document.getElementById('loadout-tags') as HTMLInputElement).value = loadout.tags.join(', ');
            (document.getElementById('loadout-featured') as HTMLInputElement).checked = loadout.featured;
            renderAttachmentsForm(loadout.attachments);
        } else {
            if (title) title.textContent = 'Add New Loadout';
            (document.getElementById('loadout-edit-id') as HTMLInputElement).value = '';
            (document.getElementById('loadout-weaponName') as HTMLInputElement).value = '';
            (document.getElementById('loadout-weaponCategory') as HTMLSelectElement).value = 'Assault Rifle';
            (document.getElementById('loadout-game') as HTMLSelectElement).value = 'Black Ops 7';
            (document.getElementById('loadout-weaponImage') as HTMLInputElement).value = '';
            (document.getElementById('loadout-description') as HTMLTextAreaElement).value = '';
            (document.getElementById('loadout-perks') as HTMLInputElement).value = '';
            (document.getElementById('loadout-tactical') as HTMLInputElement).value = '';
            (document.getElementById('loadout-lethal') as HTMLInputElement).value = '';
            (document.getElementById('loadout-tags') as HTMLInputElement).value = '';
            (document.getElementById('loadout-featured') as HTMLInputElement).checked = false;
            renderAttachmentsForm([
                { slot: 'Muzzle', name: '', tuning: '' },
                { slot: 'Barrel', name: '', tuning: '' },
                { slot: 'Underbarrel', name: '', tuning: '' },
                { slot: 'Magazine', name: '', tuning: '' },
                { slot: 'Rear Grip', name: '', tuning: '' },
            ]);
        }

        container?.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }

    function hideLoadoutForm() {
        document.getElementById('loadout-form-container')?.classList.add('hidden');
    }

    function renderAttachmentsForm(attachments: LoadoutAttachment[]) {
        const container = document.getElementById('attachments-form-list');
        if (!container) return;

        container.innerHTML = attachments.map((a, i) => `
            <div class="attachment-form-row" data-idx="${i}">
                <select class="admin-input" style="max-width:140px;" data-field="slot">
                    <option value="Muzzle" ${a.slot === 'Muzzle' ? 'selected' : ''}>Muzzle</option>
                    <option value="Barrel" ${a.slot === 'Barrel' ? 'selected' : ''}>Barrel</option>
                    <option value="Underbarrel" ${a.slot === 'Underbarrel' ? 'selected' : ''}>Underbarrel</option>
                    <option value="Magazine" ${a.slot === 'Magazine' ? 'selected' : ''}>Magazine</option>
                    <option value="Rear Grip" ${a.slot === 'Rear Grip' ? 'selected' : ''}>Rear Grip</option>
                    <option value="Stock" ${a.slot === 'Stock' ? 'selected' : ''}>Stock</option>
                    <option value="Optic" ${a.slot === 'Optic' ? 'selected' : ''}>Optic</option>
                    <option value="Laser" ${a.slot === 'Laser' ? 'selected' : ''}>Laser</option>
                    <option value="Ammunition" ${a.slot === 'Ammunition' ? 'selected' : ''}>Ammunition</option>
                    <option value="Conversion Kit" ${a.slot === 'Conversion Kit' ? 'selected' : ''}>Conversion Kit</option>
                    <option value="Perk" ${a.slot === 'Perk' ? 'selected' : ''}>Perk</option>
                </select>
                <input type="text" class="admin-input" placeholder="Attachment name" value="${a.name || ''}" data-field="name">
                <input type="text" class="admin-input" placeholder="Tuning (optional)" value="${a.tuning || ''}" data-field="tuning" style="max-width:150px;">
                <button class="delete-btn" onclick="this.closest('.attachment-form-row').remove()">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
                </button>
            </div>
        `).join('');
    }

    function addAttachmentRow() {
        const container = document.getElementById('attachments-form-list');
        if (!container) return;
        const idx = container.children.length;
        const div = document.createElement('div');
        div.className = 'attachment-form-row';
        div.setAttribute('data-idx', idx.toString());
        div.innerHTML = `
            <select class="admin-input" style="max-width:140px;" data-field="slot">
                <option value="Muzzle">Muzzle</option>
                <option value="Barrel">Barrel</option>
                <option value="Underbarrel">Underbarrel</option>
                <option value="Magazine">Magazine</option>
                <option value="Rear Grip">Rear Grip</option>
                <option value="Stock">Stock</option>
                <option value="Optic">Optic</option>
                <option value="Laser">Laser</option>
                <option value="Ammunition">Ammunition</option>
                <option value="Conversion Kit">Conversion Kit</option>
                <option value="Perk">Perk</option>
            </select>
            <input type="text" class="admin-input" placeholder="Attachment name" value="" data-field="name">
            <input type="text" class="admin-input" placeholder="Tuning (optional)" value="" data-field="tuning" style="max-width:150px;">
            <button class="delete-btn" onclick="this.closest('.attachment-form-row').remove()">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
            </button>
        `;
        container.appendChild(div);
    }

    function collectAttachmentsForm(): LoadoutAttachment[] {
        const container = document.getElementById('attachments-form-list');
        if (!container) return [];
        return Array.from(container.querySelectorAll('.attachment-form-row')).map(row => ({
            slot: (row.querySelector('[data-field="slot"]') as HTMLSelectElement)?.value || '',
            name: (row.querySelector('[data-field="name"]') as HTMLInputElement)?.value || '',
            tuning: (row.querySelector('[data-field="tuning"]') as HTMLInputElement)?.value || '',
        })).filter(a => a.name.trim() !== '');
    }

    async function saveLoadout() {
        const saveBtn = document.getElementById('save-loadout-btn') as HTMLButtonElement;
        const editId = (document.getElementById('loadout-edit-id') as HTMLInputElement).value;
        const weaponName = (document.getElementById('loadout-weaponName') as HTMLInputElement).value.trim();

        if (!weaponName) {
            showToast('Weapon name is required', 'error');
            return;
        }

        saveBtn.disabled = true;
        saveBtn.textContent = 'Saving...';

        const perksStr = (document.getElementById('loadout-perks') as HTMLInputElement).value;
        const tagsStr = (document.getElementById('loadout-tags') as HTMLInputElement).value;

        const loadoutData = {
            id: editId || undefined,
            weaponName,
            weaponCategory: (document.getElementById('loadout-weaponCategory') as HTMLSelectElement).value,
            game: (document.getElementById('loadout-game') as HTMLSelectElement).value,
            weaponImage: (document.getElementById('loadout-weaponImage') as HTMLInputElement).value.trim(),
            description: (document.getElementById('loadout-description') as HTMLTextAreaElement).value.trim(),
            attachments: collectAttachmentsForm(),
            perks: perksStr.split(',').map(p => p.trim()).filter(Boolean),
            equipment: {
                tactical: (document.getElementById('loadout-tactical') as HTMLInputElement).value.trim(),
                lethal: (document.getElementById('loadout-lethal') as HTMLInputElement).value.trim(),
            },
            tags: tagsStr.split(',').map(t => t.trim()).filter(Boolean),
            featured: (document.getElementById('loadout-featured') as HTMLInputElement).checked,
            createdAt: editId ? (adminLoadouts.find(l => l.id === editId)?.createdAt || new Date().toISOString()) : undefined,
        };

        try {
            const resp = await fetch('/api/loadouts', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(loadoutData),
            });

            if (resp.ok) {
                showToast(`Loadout ${editId ? 'updated' : 'created'} successfully!`, 'success');
                logActivity(`${editId ? 'Updated' : 'Created'} loadout: ${weaponName}`);
                hideLoadoutForm();
                await fetchAdminLoadouts();
            } else {
                throw new Error('Save failed');
            }
        } catch {
            showToast('Failed to save loadout', 'error');
        } finally {
            saveBtn.disabled = false;
            saveBtn.textContent = 'Save Loadout';
        }
    }

    (window as any).editLoadout = function(id: string) {
        const loadout = adminLoadouts.find(l => l.id === id);
        if (loadout) showLoadoutForm(loadout);
    };

    (window as any).deleteLoadout = async function(id: string, name: string) {
        if (!confirm(`Delete loadout "${name}"? This cannot be undone.`)) return;

        try {
            const resp = await fetch(`/api/loadouts?id=${id}`, { method: 'DELETE' });
            if (resp.ok) {
                showToast('Loadout deleted', 'success');
                logActivity(`Deleted loadout: ${name}`);
                await fetchAdminLoadouts();
            } else {
                throw new Error('Delete failed');
            }
        } catch {
            showToast('Failed to delete loadout', 'error');
        }
    };

    function initLoadoutsManager() {
        document.getElementById('add-loadout-btn')?.addEventListener('click', () => showLoadoutForm());
        document.getElementById('cancel-loadout-btn')?.addEventListener('click', hideLoadoutForm);
        document.getElementById('add-attachment-btn')?.addEventListener('click', addAttachmentRow);
        document.getElementById('save-loadout-btn')?.addEventListener('click', saveLoadout);
        fetchAdminLoadouts();
    }

    init();
</script>
