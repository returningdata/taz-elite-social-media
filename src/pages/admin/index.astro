---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Admin Dashboard | TazElite Plays">
    <div id="loading" class="flex flex-col items-center justify-center min-h-[80vh]">
        <div class="loading-spinner"></div>
        <p class="text-gray-400 mt-4">Loading admin panel...</p>
    </div>

    <div id="admin-content" class="hidden max-w-6xl mx-auto">
        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between mb-8">
            <div>
                <h1 class="stranger-things-title text-3xl sm:text-4xl mb-2">Admin Dashboard</h1>
                <p class="text-gray-400">Welcome back, <span id="admin-username" class="text-red-400"></span></p>
            </div>
            <div class="flex items-center gap-4 mt-4 sm:mt-0">
                <a href="/" class="text-gray-400 hover:text-white transition-colors">&larr; View Site</a>
                <a href="/api/admin/logout" class="btn text-sm">Logout</a>
            </div>
        </div>

        <!-- Quick Actions Bar -->
        <section class="mb-8">
            <div class="card bg-gradient-to-r from-red-900/20 to-transparent">
                <div class="flex flex-wrap items-center gap-3">
                    <span class="text-sm text-gray-400 mr-2">Quick Actions:</span>
                    <button id="action-export-config" class="quick-action-btn">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/></svg>
                        Export Config
                    </button>
                    <button id="action-import-config" class="quick-action-btn">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12"/></svg>
                        Import Config
                    </button>
                    <input type="file" id="import-file-input" accept=".json" class="hidden">
                    <button id="action-reset-stats" class="quick-action-btn">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/></svg>
                        Reset Today's Stats
                    </button>
                    <button id="action-preview-site" class="quick-action-btn" onclick="window.open('/', '_blank')">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/></svg>
                        Preview Site
                    </button>
                    <button id="action-copy-site-url" class="quick-action-btn">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 5H6a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2v-1M8 5a2 2 0 002 2h2a2 2 0 002-2M8 5a2 2 0 012-2h2a2 2 0 012 2m0 0h2a2 2 0 012 2v3m2 4H10m0 0l3-3m-3 3l3 3"/></svg>
                        Copy Site URL
                    </button>
                </div>
            </div>
        </section>

        <!-- Stats Section -->
        <section class="mb-8">
            <h2 class="stranger-things-title text-xl sm:text-2xl mb-4">Real-Time Analytics</h2>
            <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 mb-4">
                <div class="card text-center stat-card">
                    <div class="text-3xl font-bold text-red-400" id="stat-total-views">-</div>
                    <div class="text-sm text-gray-400">Total Views</div>
                    <div class="text-xs text-green-400 mt-1" id="stat-views-trend">-</div>
                </div>
                <div class="card text-center stat-card">
                    <div class="text-3xl font-bold text-red-400" id="stat-today-views">-</div>
                    <div class="text-sm text-gray-400">Views Today</div>
                    <div class="text-xs text-gray-500 mt-1">24h period</div>
                </div>
                <div class="card text-center stat-card">
                    <div class="text-3xl font-bold text-red-400" id="stat-total-visitors">-</div>
                    <div class="text-sm text-gray-400">Total Visitors</div>
                    <div class="text-xs text-green-400 mt-1" id="stat-visitors-trend">-</div>
                </div>
                <div class="card text-center stat-card">
                    <div class="text-3xl font-bold text-red-400" id="stat-today-visitors">-</div>
                    <div class="text-sm text-gray-400">Visitors Today</div>
                    <div class="text-xs text-gray-500 mt-1">24h period</div>
                </div>
            </div>

            <!-- Extended Stats -->
            <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
                <div class="card text-center">
                    <div class="text-2xl font-bold text-blue-400" id="stat-avg-views">-</div>
                    <div class="text-sm text-gray-400">Avg Daily Views</div>
                </div>
                <div class="card text-center">
                    <div class="text-2xl font-bold text-purple-400" id="stat-bounce-rate">-</div>
                    <div class="text-sm text-gray-400">Return Rate</div>
                </div>
                <div class="card text-center">
                    <div class="text-2xl font-bold text-yellow-400" id="stat-peak-hour">-</div>
                    <div class="text-sm text-gray-400">Peak Hour</div>
                </div>
                <div class="card text-center">
                    <div class="text-2xl font-bold text-green-400" id="stat-uptime">99.9%</div>
                    <div class="text-sm text-gray-400">Uptime</div>
                </div>
            </div>
            <p class="text-xs text-gray-500 mt-2">Last updated: <span id="stats-updated">-</span> | Auto-refresh: 30s</p>
        </section>

        <!-- Tabs -->
        <div class="flex flex-wrap gap-2 mb-6 border-b border-red-900/50 pb-4">
            <button class="tab-btn active" data-tab="site">Site Content</button>
            <button class="tab-btn" data-tab="social">Social Links</button>
            <button class="tab-btn" data-tab="theme">Theme</button>
            <button class="tab-btn" data-tab="features">Features</button>
            <button class="tab-btn" data-tab="announcements">Announcements</button>
            <button class="tab-btn" data-tab="schedule">Stream Schedule</button>
            <button class="tab-btn" data-tab="seo">SEO & Meta</button>
            <button class="tab-btn" data-tab="navigation">Navigation</button>
            <button class="tab-btn" data-tab="loadouts">COD Loadouts</button>
            <button class="tab-btn" data-tab="custom">Custom Code</button>
            <button class="tab-btn" data-tab="backup">Backup & Tools</button>
        </div>

        <!-- Tab Content -->
        <div id="tab-site" class="tab-content">
            <div class="card">
                <h3 class="text-xl font-bold text-red-400 mb-4">Site Content</h3>
                <div class="space-y-4">
                    <div>
                        <label class="block text-sm font-medium text-gray-300 mb-1">Site Title</label>
                        <input type="text" id="config-site-title" class="admin-input" placeholder="TazElite Plays">
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-300 mb-1">Subtitle</label>
                        <input type="text" id="config-site-subtitle" class="admin-input" placeholder="Gaming Content Creator & Community Builder">
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-300 mb-1">Tagline</label>
                        <input type="text" id="config-site-tagline" class="admin-input" placeholder="Welcome to The Upside Down">
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-300 mb-1">About Title</label>
                        <input type="text" id="config-site-aboutTitle" class="admin-input" placeholder="About Me">
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-300 mb-1">About Text (Paragraph 1)</label>
                        <textarea id="config-site-aboutText" class="admin-input h-24" placeholder="First paragraph..."></textarea>
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-300 mb-1">About Text (Paragraph 2)</label>
                        <textarea id="config-site-aboutText2" class="admin-input h-24" placeholder="Second paragraph..."></textarea>
                    </div>
                </div>
            </div>
        </div>

        <div id="tab-social" class="tab-content hidden">
            <div class="card">
                <h3 class="text-xl font-bold text-red-400 mb-4">Social Links</h3>
                <div class="space-y-4">
                    <div>
                        <label class="block text-sm font-medium text-gray-300 mb-1">Twitch Username</label>
                        <input type="text" id="config-social-twitch" class="admin-input" placeholder="tazeliteplays">
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-300 mb-1">Discord Invite URL</label>
                        <input type="text" id="config-social-discord" class="admin-input" placeholder="https://discord.gg/...">
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-300 mb-1">YouTube URL</label>
                        <input type="text" id="config-social-youtube" class="admin-input" placeholder="https://www.youtube.com/@...">
                    </div>
                </div>
            </div>
        </div>

        <div id="tab-theme" class="tab-content hidden">
            <div class="card">
                <h3 class="text-xl font-bold text-red-400 mb-4">Theme Settings</h3>
                <div class="space-y-4">
                    <div>
                        <label class="block text-sm font-medium text-gray-300 mb-1">Theme Preset</label>
                        <select id="config-theme-name" class="admin-input">
                            <option value="stranger-things">Stranger Things (Red/Dark)</option>
                            <option value="cyberpunk">Cyberpunk (Neon/Purple)</option>
                            <option value="forest">Forest (Green/Dark)</option>
                            <option value="ocean">Ocean (Blue/Dark)</option>
                            <option value="sunset">Sunset (Orange/Dark)</option>
                            <option value="custom">Custom</option>
                        </select>
                    </div>
                    <div id="custom-theme-options" class="space-y-4 pt-4 border-t border-red-900/30">
                        <div>
                            <label class="block text-sm font-medium text-gray-300 mb-1">Primary Color</label>
                            <div class="flex items-center gap-2">
                                <input type="color" id="config-theme-primaryColor" class="w-12 h-10 rounded cursor-pointer">
                                <input type="text" id="config-theme-primaryColor-text" class="admin-input flex-1" placeholder="#e50914">
                            </div>
                        </div>
                        <div>
                            <label class="block text-sm font-medium text-gray-300 mb-1">Accent Color</label>
                            <div class="flex items-center gap-2">
                                <input type="color" id="config-theme-accentColor" class="w-12 h-10 rounded cursor-pointer">
                                <input type="text" id="config-theme-accentColor-text" class="admin-input flex-1" placeholder="#b81c24">
                            </div>
                        </div>
                        <div>
                            <label class="block text-sm font-medium text-gray-300 mb-1">Background Start</label>
                            <div class="flex items-center gap-2">
                                <input type="color" id="config-theme-backgroundStart" class="w-12 h-10 rounded cursor-pointer">
                                <input type="text" id="config-theme-backgroundStart-text" class="admin-input flex-1" placeholder="#0a0a0a">
                            </div>
                        </div>
                        <div>
                            <label class="block text-sm font-medium text-gray-300 mb-1">Background End</label>
                            <div class="flex items-center gap-2">
                                <input type="color" id="config-theme-backgroundEnd" class="w-12 h-10 rounded cursor-pointer">
                                <input type="text" id="config-theme-backgroundEnd-text" class="admin-input flex-1" placeholder="#1a0505">
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Theme Preview -->
                <div class="mt-6 pt-4 border-t border-red-900/30">
                    <h4 class="text-sm font-medium text-gray-300 mb-3">Preview</h4>
                    <div id="theme-preview" class="p-4 rounded-lg" style="background: linear-gradient(180deg, #0a0a0a, #1a0505);">
                        <div class="text-center">
                            <h5 id="preview-title" class="text-xl font-bold mb-2" style="color: #e50914; text-shadow: 0 0 10px rgba(229, 9, 20, 0.5);">TazElite Plays</h5>
                            <p class="text-gray-300 text-sm">Preview of your theme</p>
                            <button id="preview-btn" class="mt-3 px-4 py-2 rounded text-white text-sm" style="background: #e50914;">Sample Button</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div id="tab-features" class="tab-content hidden">
            <div class="card">
                <h3 class="text-xl font-bold text-red-400 mb-4">Feature Toggles</h3>
                <div class="space-y-4">
                    <label class="flex items-center gap-3 cursor-pointer">
                        <input type="checkbox" id="config-features-fallingMonsters" class="admin-checkbox">
                        <span class="text-gray-300">Falling Monsters Animation</span>
                    </label>
                    <label class="flex items-center gap-3 cursor-pointer">
                        <input type="checkbox" id="config-features-musicPlayer" class="admin-checkbox">
                        <span class="text-gray-300">Music Player</span>
                    </label>
                    <label class="flex items-center gap-3 cursor-pointer">
                        <input type="checkbox" id="config-features-discordPresence" class="admin-checkbox">
                        <span class="text-gray-300">Discord Presence Display</span>
                    </label>
                    <label class="flex items-center gap-3 cursor-pointer">
                        <input type="checkbox" id="config-features-twitchStatus" class="admin-checkbox">
                        <span class="text-gray-300">Twitch Status Display</span>
                    </label>
                </div>
            </div>

            <div class="card mt-4">
                <h3 class="text-xl font-bold text-red-400 mb-4">Advanced Features</h3>
                <div class="space-y-4">
                    <label class="flex items-center gap-3 cursor-pointer">
                        <input type="checkbox" id="config-features-showAnnouncement" class="admin-checkbox">
                        <span class="text-gray-300">Show Site Announcement Banner</span>
                    </label>
                    <label class="flex items-center gap-3 cursor-pointer">
                        <input type="checkbox" id="config-features-showSchedule" class="admin-checkbox">
                        <span class="text-gray-300">Show Stream Schedule Section</span>
                    </label>
                    <label class="flex items-center gap-3 cursor-pointer">
                        <input type="checkbox" id="config-features-enableAnalytics" class="admin-checkbox" checked>
                        <span class="text-gray-300">Enable Page View Tracking</span>
                    </label>
                    <label class="flex items-center gap-3 cursor-pointer">
                        <input type="checkbox" id="config-features-showWhatIDo" class="admin-checkbox" checked>
                        <span class="text-gray-300">Show "What I Do" Section</span>
                    </label>
                    <label class="flex items-center gap-3 cursor-pointer">
                        <input type="checkbox" id="config-features-showAbout" class="admin-checkbox" checked>
                        <span class="text-gray-300">Show About Section</span>
                    </label>
                    <label class="flex items-center gap-3 cursor-pointer">
                        <input type="checkbox" id="config-features-maintenanceMode" class="admin-checkbox">
                        <span class="text-gray-300">Maintenance Mode (Site Offline)</span>
                    </label>
                </div>
            </div>
        </div>

        <!-- Announcements Tab -->
        <div id="tab-announcements" class="tab-content hidden">
            <div class="card">
                <h3 class="text-xl font-bold text-red-400 mb-4">Site Announcement</h3>
                <p class="text-sm text-gray-400 mb-4">Display an announcement banner at the top of your site.</p>
                <div class="space-y-4">
                    <label class="flex items-center gap-3 cursor-pointer">
                        <input type="checkbox" id="config-announcement-enabled" class="admin-checkbox">
                        <span class="text-gray-300">Enable Announcement Banner</span>
                    </label>
                    <div>
                        <label class="block text-sm font-medium text-gray-300 mb-1">Announcement Text</label>
                        <input type="text" id="config-announcement-text" class="admin-input" placeholder="New stream schedule! Check out my latest videos...">
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-300 mb-1">Link URL (optional)</label>
                        <input type="text" id="config-announcement-link" class="admin-input" placeholder="https://...">
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-300 mb-1">Link Text</label>
                        <input type="text" id="config-announcement-linkText" class="admin-input" placeholder="Learn more">
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-300 mb-1">Banner Style</label>
                        <select id="config-announcement-style" class="admin-input">
                            <option value="info">Info (Blue)</option>
                            <option value="success">Success (Green)</option>
                            <option value="warning">Warning (Yellow)</option>
                            <option value="danger">Important (Red)</option>
                            <option value="themed">Match Theme</option>
                        </select>
                    </div>
                    <label class="flex items-center gap-3 cursor-pointer">
                        <input type="checkbox" id="config-announcement-dismissable" class="admin-checkbox" checked>
                        <span class="text-gray-300">Allow users to dismiss</span>
                    </label>
                </div>
            </div>

            <div class="card mt-4">
                <h3 class="text-xl font-bold text-red-400 mb-4">Pinned Messages</h3>
                <p class="text-sm text-gray-400 mb-4">Add important messages that appear on your site.</p>
                <div id="pinned-messages-container" class="space-y-3 mb-4"></div>
                <button id="add-pinned-message" class="quick-action-btn">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
                    Add Pinned Message
                </button>
            </div>
        </div>

        <!-- Stream Schedule Tab -->
        <div id="tab-schedule" class="tab-content hidden">
            <div class="card">
                <h3 class="text-xl font-bold text-red-400 mb-4">Stream Schedule</h3>
                <p class="text-sm text-gray-400 mb-4">Set your weekly streaming schedule. This will be displayed on your site.</p>

                <div class="space-y-4">
                    <div>
                        <label class="block text-sm font-medium text-gray-300 mb-1">Timezone</label>
                        <select id="config-schedule-timezone" class="admin-input">
                            <option value="America/New_York">Eastern Time (ET)</option>
                            <option value="America/Chicago">Central Time (CT)</option>
                            <option value="America/Denver">Mountain Time (MT)</option>
                            <option value="America/Los_Angeles">Pacific Time (PT)</option>
                            <option value="Europe/London">GMT/BST (UK)</option>
                            <option value="Europe/Paris">Central European Time</option>
                            <option value="Asia/Tokyo">Japan Standard Time</option>
                            <option value="Australia/Sydney">Australian Eastern Time</option>
                        </select>
                    </div>
                </div>

                <div class="mt-6 space-y-4">
                    <div class="schedule-day">
                        <div class="flex items-center gap-3 mb-2">
                            <input type="checkbox" id="config-schedule-monday-enabled" class="admin-checkbox">
                            <span class="text-gray-300 font-medium w-24">Monday</span>
                            <input type="time" id="config-schedule-monday-start" class="admin-input w-32" value="19:00">
                            <span class="text-gray-400">to</span>
                            <input type="time" id="config-schedule-monday-end" class="admin-input w-32" value="22:00">
                        </div>
                        <input type="text" id="config-schedule-monday-title" class="admin-input ml-10" placeholder="What are you streaming?">
                    </div>

                    <div class="schedule-day">
                        <div class="flex items-center gap-3 mb-2">
                            <input type="checkbox" id="config-schedule-tuesday-enabled" class="admin-checkbox">
                            <span class="text-gray-300 font-medium w-24">Tuesday</span>
                            <input type="time" id="config-schedule-tuesday-start" class="admin-input w-32" value="19:00">
                            <span class="text-gray-400">to</span>
                            <input type="time" id="config-schedule-tuesday-end" class="admin-input w-32" value="22:00">
                        </div>
                        <input type="text" id="config-schedule-tuesday-title" class="admin-input ml-10" placeholder="What are you streaming?">
                    </div>

                    <div class="schedule-day">
                        <div class="flex items-center gap-3 mb-2">
                            <input type="checkbox" id="config-schedule-wednesday-enabled" class="admin-checkbox">
                            <span class="text-gray-300 font-medium w-24">Wednesday</span>
                            <input type="time" id="config-schedule-wednesday-start" class="admin-input w-32" value="19:00">
                            <span class="text-gray-400">to</span>
                            <input type="time" id="config-schedule-wednesday-end" class="admin-input w-32" value="22:00">
                        </div>
                        <input type="text" id="config-schedule-wednesday-title" class="admin-input ml-10" placeholder="What are you streaming?">
                    </div>

                    <div class="schedule-day">
                        <div class="flex items-center gap-3 mb-2">
                            <input type="checkbox" id="config-schedule-thursday-enabled" class="admin-checkbox">
                            <span class="text-gray-300 font-medium w-24">Thursday</span>
                            <input type="time" id="config-schedule-thursday-start" class="admin-input w-32" value="19:00">
                            <span class="text-gray-400">to</span>
                            <input type="time" id="config-schedule-thursday-end" class="admin-input w-32" value="22:00">
                        </div>
                        <input type="text" id="config-schedule-thursday-title" class="admin-input ml-10" placeholder="What are you streaming?">
                    </div>

                    <div class="schedule-day">
                        <div class="flex items-center gap-3 mb-2">
                            <input type="checkbox" id="config-schedule-friday-enabled" class="admin-checkbox">
                            <span class="text-gray-300 font-medium w-24">Friday</span>
                            <input type="time" id="config-schedule-friday-start" class="admin-input w-32" value="20:00">
                            <span class="text-gray-400">to</span>
                            <input type="time" id="config-schedule-friday-end" class="admin-input w-32" value="24:00">
                        </div>
                        <input type="text" id="config-schedule-friday-title" class="admin-input ml-10" placeholder="What are you streaming?">
                    </div>

                    <div class="schedule-day">
                        <div class="flex items-center gap-3 mb-2">
                            <input type="checkbox" id="config-schedule-saturday-enabled" class="admin-checkbox">
                            <span class="text-gray-300 font-medium w-24">Saturday</span>
                            <input type="time" id="config-schedule-saturday-start" class="admin-input w-32" value="14:00">
                            <span class="text-gray-400">to</span>
                            <input type="time" id="config-schedule-saturday-end" class="admin-input w-32" value="20:00">
                        </div>
                        <input type="text" id="config-schedule-saturday-title" class="admin-input ml-10" placeholder="What are you streaming?">
                    </div>

                    <div class="schedule-day">
                        <div class="flex items-center gap-3 mb-2">
                            <input type="checkbox" id="config-schedule-sunday-enabled" class="admin-checkbox">
                            <span class="text-gray-300 font-medium w-24">Sunday</span>
                            <input type="time" id="config-schedule-sunday-start" class="admin-input w-32" value="14:00">
                            <span class="text-gray-400">to</span>
                            <input type="time" id="config-schedule-sunday-end" class="admin-input w-32" value="18:00">
                        </div>
                        <input type="text" id="config-schedule-sunday-title" class="admin-input ml-10" placeholder="What are you streaming?">
                    </div>
                </div>
            </div>

            <div class="card mt-4">
                <h3 class="text-xl font-bold text-red-400 mb-4">Upcoming Special Streams</h3>
                <p class="text-sm text-gray-400 mb-4">Add special one-time stream events.</p>
