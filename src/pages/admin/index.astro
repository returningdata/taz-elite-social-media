<script>
    // Theme presets
    const themePresets: Record<string, { primaryColor: string; accentColor: string; backgroundStart: string; backgroundEnd: string }> = {
        'stranger-things': {
            primaryColor: '#e50914',
            accentColor: '#b81c24',
            backgroundStart: '#0a0a0a',
            backgroundEnd: '#1a0505',
        },
        'cyberpunk': {
            primaryColor: '#00f0ff',
            accentColor: '#ff00ff',
            backgroundStart: '#0a0a1a',
            backgroundEnd: '#1a0520',
        },
        'forest': {
            primaryColor: '#22c55e',
            accentColor: '#15803d',
            backgroundStart: '#0a0f0a',
            backgroundEnd: '#051a05',
        },
        'ocean': {
            primaryColor: '#0ea5e9',
            accentColor: '#0369a1',
            backgroundStart: '#0a0a0f',
            backgroundEnd: '#051520',
        },
        'sunset': {
            primaryColor: '#f97316',
            accentColor: '#ea580c',
            backgroundStart: '#0f0a0a',
            backgroundEnd: '#1a1005',
        },
    };

    interface SiteConfig {
        site: {
            title: string;
            subtitle: string;
            tagline: string;
            aboutTitle: string;
            aboutText: string;
            aboutText2: string;
        };
        theme: {
            name: string;
            primaryColor: string;
            accentColor: string;
            backgroundStart: string;
            backgroundEnd: string;
        };
        social: {
            twitch: string;
            discord: string;
            youtube: string;
        };
        features: {
            fallingMonsters: boolean;
            musicPlayer: boolean;
            discordPresence: boolean;
            twitchStatus: boolean;
            showAnnouncement: boolean;
            showSchedule: boolean;
            enableAnalytics: boolean;
            showWhatIDo: boolean;
            showAbout: boolean;
            maintenanceMode: boolean;
        };
        announcement: {
            enabled: boolean;
            text: string;
            link: string;
            linkText: string;
            style: string;
            dismissable: boolean;
        };
        pinnedMessages: Array<{ id: string; text: string; type: string }>;
        schedule: {
            timezone: string;
            days: Record<string, { enabled: boolean; start: string; end: string; title: string }>;
            specialStreams: Array<{ id: string; date: string; time: string; title: string; description: string }>;
        };
        seo: {
            title: string;
            description: string;
            keywords: string;
            ogTitle: string;
            ogDescription: string;
            ogImage: string;
            twitterHandle: string;
            canonical: string;
            googleVerification: string;
            noindex: boolean;
        };
        navigation: {
            links: Array<{ id: string; label: string; url: string; newTab: boolean }>;
        };
        footer: {
            text: string;
            tagline: string;
            showSocial: boolean;
            showYear: boolean;
            links: Array<{ id: string; label: string; url: string }>;
        };
        custom: {
            css: string;
            headCode: string;
            footerCode: string;
            redirects: Array<{ id: string; from: string; to: string; status: string }>;
        };
    }

    let currentConfig: SiteConfig;

    // Check authentication
    async function checkAuth() {
        try {
            const response = await fetch('/api/admin/session');
            if (!response.ok) {
                window.location.href = '/admin/login';
                return null;
            }
            return await response.json();
        } catch (e) {
            window.location.href = '/admin/login';
            return null;
        }
    }

    // Load config
    async function loadConfig() {
        try {
            const response = await fetch('/api/admin/config');
            return await response.json();
        } catch (e) {
            console.error('Failed to load config:', e);
            return null;
        }
    }

    // Load stats
    async function loadStats() {
        try {
            const response = await fetch('/api/admin/stats');
            if (response.ok) {
                const stats = await response.json();
                const el = (id: string) => document.getElementById(id);
                if (el('stat-total-views')) el('stat-total-views')!.textContent = stats.pageViews?.total?.toString() || '0';
                if (el('stat-today-views')) el('stat-today-views')!.textContent = stats.pageViews?.today?.toString() || '0';
                if (el('stat-total-visitors')) el('stat-total-visitors')!.textContent = stats.uniqueVisitors?.total?.toString() || '0';
                if (el('stat-today-visitors')) el('stat-today-visitors')!.textContent = stats.uniqueVisitors?.today?.toString() || '0';
                if (el('stats-updated')) el('stats-updated')!.textContent = new Date(stats.lastUpdated).toLocaleString();

                // Calculate extended stats
                const totalViews = stats.pageViews?.total || 0;
                const totalVisitors = stats.uniqueVisitors?.total || 0;
                const todayViews = stats.pageViews?.today || 0;

                // Estimated average daily views
                const avgDaily = Math.round(totalViews / Math.max(1, Math.ceil((Date.now() - (stats.firstVisit || Date.now())) / 86400000)));
                if (el('stat-avg-views')) el('stat-avg-views')!.textContent = avgDaily.toString();

                // Return rate (visitors who viewed multiple pages)
                const returnRate = totalVisitors > 0 ? Math.round((totalViews / totalVisitors - 1) * 100) : 0;
                if (el('stat-bounce-rate')) el('stat-bounce-rate')!.textContent = `${Math.min(100, Math.max(0, returnRate))}%`;

                // Peak hour placeholder
                if (el('stat-peak-hour')) el('stat-peak-hour')!.textContent = '8PM';

                // Trends
                if (el('stat-views-trend') && todayViews > 0) {
                    el('stat-views-trend')!.textContent = `+${todayViews} today`;
                }
                if (el('stat-visitors-trend') && stats.uniqueVisitors?.today > 0) {
                    el('stat-visitors-trend')!.textContent = `+${stats.uniqueVisitors.today} today`;
                }
            }
        } catch (e) {
            console.error('Failed to load stats:', e);
        }
    }

    // Populate form
    function populateForm(config: SiteConfig) {
        const el = (id: string) => document.getElementById(id) as HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement | null;

        // Site content
        if (el('config-site-title')) el('config-site-title')!.value = config.site?.title || '';
        if (el('config-site-subtitle')) el('config-site-subtitle')!.value = config.site?.subtitle || '';
        if (el('config-site-tagline')) el('config-site-tagline')!.value = config.site?.tagline || '';
        if (el('config-site-aboutTitle')) el('config-site-aboutTitle')!.value = config.site?.aboutTitle || '';
        if (el('config-site-aboutText')) el('config-site-aboutText')!.value = config.site?.aboutText || '';
        if (el('config-site-aboutText2')) el('config-site-aboutText2')!.value = config.site?.aboutText2 || '';

        // Social links
        if (el('config-social-twitch')) el('config-social-twitch')!.value = config.social?.twitch || '';
        if (el('config-social-discord')) el('config-social-discord')!.value = config.social?.discord || '';
        if (el('config-social-youtube')) el('config-social-youtube')!.value = config.social?.youtube || '';

        // Theme
        if (el('config-theme-name')) (el('config-theme-name') as HTMLSelectElement).value = config.theme?.name || 'stranger-things';
        updateThemeColors(config.theme);

        // Features
        if (el('config-features-fallingMonsters')) (el('config-features-fallingMonsters') as HTMLInputElement).checked = config.features?.fallingMonsters ?? true;
        if (el('config-features-musicPlayer')) (el('config-features-musicPlayer') as HTMLInputElement).checked = config.features?.musicPlayer ?? true;
        if (el('config-features-discordPresence')) (el('config-features-discordPresence') as HTMLInputElement).checked = config.features?.discordPresence ?? true;
        if (el('config-features-twitchStatus')) (el('config-features-twitchStatus') as HTMLInputElement).checked = config.features?.twitchStatus ?? true;
        if (el('config-features-showAnnouncement')) (el('config-features-showAnnouncement') as HTMLInputElement).checked = config.features?.showAnnouncement ?? false;
        if (el('config-features-showSchedule')) (el('config-features-showSchedule') as HTMLInputElement).checked = config.features?.showSchedule ?? false;
        if (el('config-features-enableAnalytics')) (el('config-features-enableAnalytics') as HTMLInputElement).checked = config.features?.enableAnalytics ?? true;
        if (el('config-features-showWhatIDo')) (el('config-features-showWhatIDo') as HTMLInputElement).checked = config.features?.showWhatIDo ?? true;
        if (el('config-features-showAbout')) (el('config-features-showAbout') as HTMLInputElement).checked = config.features?.showAbout ?? true;
        if (el('config-features-maintenanceMode')) (el('config-features-maintenanceMode') as HTMLInputElement).checked = config.features?.maintenanceMode ?? false;

        // Announcement
        if (el('config-announcement-enabled')) (el('config-announcement-enabled') as HTMLInputElement).checked = config.announcement?.enabled ?? false;
        if (el('config-announcement-text')) el('config-announcement-text')!.value = config.announcement?.text || '';
        if (el('config-announcement-link')) el('config-announcement-link')!.value = config.announcement?.link || '';
        if (el('config-announcement-linkText')) el('config-announcement-linkText')!.value = config.announcement?.linkText || '';
        if (el('config-announcement-style')) (el('config-announcement-style') as HTMLSelectElement).value = config.announcement?.style || 'info';
        if (el('config-announcement-dismissable')) (el('config-announcement-dismissable') as HTMLInputElement).checked = config.announcement?.dismissable ?? true;

        // Schedule
        if (el('config-schedule-timezone')) (el('config-schedule-timezone') as HTMLSelectElement).value = config.schedule?.timezone || 'America/New_York';
        const days = ['monday', 'tuesday', 'wednesday', 'thursday', 'friday', 'saturday', 'sunday'];
        days.forEach(day => {
            const dayConfig = config.schedule?.days?.[day];
            if (el(`config-schedule-${day}-enabled`)) (el(`config-schedule-${day}-enabled`) as HTMLInputElement).checked = dayConfig?.enabled ?? false;
            if (el(`config-schedule-${day}-start`)) el(`config-schedule-${day}-start`)!.value = dayConfig?.start || '19:00';
            if (el(`config-schedule-${day}-end`)) el(`config-schedule-${day}-end`)!.value = dayConfig?.end || '22:00';
            if (el(`config-schedule-${day}-title`)) el(`config-schedule-${day}-title`)!.value = dayConfig?.title || '';
        });

        // SEO
        if (el('config-seo-title')) el('config-seo-title')!.value = config.seo?.title || '';
        if (el('config-seo-description')) el('config-seo-description')!.value = config.seo?.description || '';
        if (el('config-seo-keywords')) el('config-seo-keywords')!.value = config.seo?.keywords || '';
        if (el('config-seo-ogTitle')) el('config-seo-ogTitle')!.value = config.seo?.ogTitle || '';
        if (el('config-seo-ogDescription')) el('config-seo-ogDescription')!.value = config.seo?.ogDescription || '';
        if (el('config-seo-ogImage')) el('config-seo-ogImage')!.value = config.seo?.ogImage || '';
        if (el('config-seo-twitterHandle')) el('config-seo-twitterHandle')!.value = config.seo?.twitterHandle || '';
        if (el('config-seo-canonical')) el('config-seo-canonical')!.value = config.seo?.canonical || '';
        if (el('config-seo-googleVerification')) el('config-seo-googleVerification')!.value = config.seo?.googleVerification || '';
        if (el('config-seo-noindex')) (el('config-seo-noindex') as HTMLInputElement).checked = config.seo?.noindex ?? false;

        // Footer
        if (el('config-footer-text')) el('config-footer-text')!.value = config.footer?.text || '';
        if (el('config-footer-tagline')) el('config-footer-tagline')!.value = config.footer?.tagline || '';
        if (el('config-footer-showSocial')) (el('config-footer-showSocial') as HTMLInputElement).checked = config.footer?.showSocial ?? true;
        if (el('config-footer-showYear')) (el('config-footer-showYear') as HTMLInputElement).checked = config.footer?.showYear ?? true;

        // Custom Code
        if (el('config-custom-css')) el('config-custom-css')!.value = config.custom?.css || '';
        if (el('config-custom-headCode')) el('config-custom-headCode')!.value = config.custom?.headCode || '';
        if (el('config-custom-footerCode')) el('config-custom-footerCode')!.value = config.custom?.footerCode || '';

        // Render dynamic lists
        renderNavLinks(config.navigation?.links || []);
        renderFooterLinks(config.footer?.links || []);
        renderPinnedMessages(config.pinnedMessages || []);
        renderSpecialStreams(config.schedule?.specialStreams || []);
        renderRedirects(config.custom?.redirects || []);

        updateThemePreview();
        updateOgPreview();
    }

    function updateThemeColors(theme: SiteConfig['theme']) {
        const el = (id: string) => document.getElementById(id) as HTMLInputElement | null;

        const colors = {
            primaryColor: theme?.primaryColor || '#e50914',
            accentColor: theme?.accentColor || '#b81c24',
            backgroundStart: theme?.backgroundStart || '#0a0a0a',
            backgroundEnd: theme?.backgroundEnd || '#1a0505',
        };

        if (el('config-theme-primaryColor')) el('config-theme-primaryColor')!.value = colors.primaryColor;
        if (el('config-theme-primaryColor-text')) el('config-theme-primaryColor-text')!.value = colors.primaryColor;
        if (el('config-theme-accentColor')) el('config-theme-accentColor')!.value = colors.accentColor;
        if (el('config-theme-accentColor-text')) el('config-theme-accentColor-text')!.value = colors.accentColor;
        if (el('config-theme-backgroundStart')) el('config-theme-backgroundStart')!.value = colors.backgroundStart;
        if (el('config-theme-backgroundStart-text')) el('config-theme-backgroundStart-text')!.value = colors.backgroundStart;
        if (el('config-theme-backgroundEnd')) el('config-theme-backgroundEnd')!.value = colors.backgroundEnd;
        if (el('config-theme-backgroundEnd-text')) el('config-theme-backgroundEnd-text')!.value = colors.backgroundEnd;
    }

    function updateThemePreview() {
        const preview = document.getElementById('theme-preview');
        const previewTitle = document.getElementById('preview-title');
        const previewBtn = document.getElementById('preview-btn');

        const primaryColor = (document.getElementById('config-theme-primaryColor') as HTMLInputElement)?.value || '#e50914';
        const backgroundStart = (document.getElementById('config-theme-backgroundStart') as HTMLInputElement)?.value || '#0a0a0a';
        const backgroundEnd = (document.getElementById('config-theme-backgroundEnd') as HTMLInputElement)?.value || '#1a0505';

        if (preview) {
            preview.style.background = `linear-gradient(180deg, ${backgroundStart}, ${backgroundEnd})`;
        }
        if (previewTitle) {
            previewTitle.style.color = primaryColor;
            previewTitle.style.textShadow = `0 0 10px ${primaryColor}80`;
        }
        if (previewBtn) {
            previewBtn.style.background = primaryColor;
        }
    }

    // Collect form data
    function collectFormData(): SiteConfig {
        const el = (id: string) => document.getElementById(id) as HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement | null;
        const days = ['monday', 'tuesday', 'wednesday', 'thursday', 'friday', 'saturday', 'sunday'];

        const scheduleDays: Record<string, { enabled: boolean; start: string; end: string; title: string }> = {};
        days.forEach(day => {
            scheduleDays[day] = {
                enabled: (el(`config-schedule-${day}-enabled`) as HTMLInputElement)?.checked ?? false,
                start: el(`config-schedule-${day}-start`)?.value || '19:00',
                end: el(`config-schedule-${day}-end`)?.value || '22:00',
                title: el(`config-schedule-${day}-title`)?.value || '',
            };
        });

        return {
            site: {
                title: el('config-site-title')?.value || '',
                subtitle: el('config-site-subtitle')?.value || '',
                tagline: el('config-site-tagline')?.value || '',
                aboutTitle: el('config-site-aboutTitle')?.value || '',
                aboutText: el('config-site-aboutText')?.value || '',
                aboutText2: el('config-site-aboutText2')?.value || '',
            },
            theme: {
                name: (el('config-theme-name') as HTMLSelectElement)?.value || 'stranger-things',
                primaryColor: el('config-theme-primaryColor')?.value || '#e50914',
                accentColor: el('config-theme-accentColor')?.value || '#b81c24',
                backgroundStart: el('config-theme-backgroundStart')?.value || '#0a0a0a',
                backgroundEnd: el('config-theme-backgroundEnd')?.value || '#1a0505',
            },
            social: {
                twitch: el('config-social-twitch')?.value || '',
                discord: el('config-social-discord')?.value || '',
                youtube: el('config-social-youtube')?.value || '',
            },
            features: {
                fallingMonsters: (el('config-features-fallingMonsters') as HTMLInputElement)?.checked ?? true,
                musicPlayer: (el('config-features-musicPlayer') as HTMLInputElement)?.checked ?? true,
                discordPresence: (el('config-features-discordPresence') as HTMLInputElement)?.checked ?? true,
                twitchStatus: (el('config-features-twitchStatus') as HTMLInputElement)?.checked ?? true,
                showAnnouncement: (el('config-features-showAnnouncement') as HTMLInputElement)?.checked ?? false,
                showSchedule: (el('config-features-showSchedule') as HTMLInputElement)?.checked ?? false,
                enableAnalytics: (el('config-features-enableAnalytics') as HTMLInputElement)?.checked ?? true,
                showWhatIDo: (el('config-features-showWhatIDo') as HTMLInputElement)?.checked ?? true,
                showAbout: (el('config-features-showAbout') as HTMLInputElement)?.checked ?? true,
                maintenanceMode: (el('config-features-maintenanceMode') as HTMLInputElement)?.checked ?? false,
            },
            announcement: {
                enabled: (el('config-announcement-enabled') as HTMLInputElement)?.checked ?? false,
                text: el('config-announcement-text')?.value || '',
                link: el('config-announcement-link')?.value || '',
                linkText: el('config-announcement-linkText')?.value || '',
                style: (el('config-announcement-style') as HTMLSelectElement)?.value || 'info',
                dismissable: (el('config-announcement-dismissable') as HTMLInputElement)?.checked ?? true,
            },
            pinnedMessages: collectPinnedMessages(),
            schedule: {
                timezone: (el('config-schedule-timezone') as HTMLSelectElement)?.value || 'America/New_York',
                days: scheduleDays,
                specialStreams: collectSpecialStreams(),
            },
            seo: {
                title: el('config-seo-title')?.value || '',
                description: el('config-seo-description')?.value || '',
                keywords: el('config-seo-keywords')?.value || '',
                ogTitle: el('config-seo-ogTitle')?.value || '',
                ogDescription: el('config-seo-ogDescription')?.value || '',
                ogImage: el('config-seo-ogImage')?.value || '',
                twitterHandle: el('config-seo-twitterHandle')?.value || '',
                canonical: el('config-seo-canonical')?.value || '',
                googleVerification: el('config-seo-googleVerification')?.value || '',
                noindex: (el('config-seo-noindex') as HTMLInputElement)?.checked ?? false,
            },
            navigation: {
                links: collectNavLinks(),
            },
            footer: {
                text: el('config-footer-text')?.value || '',
                tagline: el('config-footer-tagline')?.value || '',
                showSocial: (el('config-footer-showSocial') as HTMLInputElement)?.checked ?? true,
                showYear: (el('config-footer-showYear') as HTMLInputElement)?.checked ?? true,
                links: collectFooterLinks(),
            },
            custom: {
                css: el('config-custom-css')?.value || '',
                headCode: el('config-custom-headCode')?.value || '',
                footerCode: el('config-custom-footerCode')?.value || '',
                redirects: collectRedirects(),
            },
        };
    }

    // Dynamic list rendering functions
    function generateId() {
        return 'id_' + Math.random().toString(36).substr(2, 9);
    }

    function renderNavLinks(links: Array<{ id: string; label: string; url: string; newTab: boolean }>) {
        const container = document.getElementById('nav-links-container');
        if (!container) return;
        container.innerHTML = links.map(link => `
            <div class="dynamic-item" data-id="${link.id}">
                <input type="text" class="admin-input" placeholder="Label" value="${link.label}" data-field="label">
                <input type="text" class="admin-input" placeholder="URL" value="${link.url}" data-field="url">
                <label class="flex items-center gap-1 text-xs text-gray-400 whitespace-nowrap">
                    <input type="checkbox" class="admin-checkbox" ${link.newTab ? 'checked' : ''} data-field="newTab">
                    New tab
                </label>
                <button class="delete-btn" onclick="deleteItem(this)">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
                </button>
            </div>
        `).join('');
    }

    function renderFooterLinks(links: Array<{ id: string; label: string; url: string }>) {
        const container = document.getElementById('footer-links-container');
        if (!container) return;
        container.innerHTML = links.map(link => `
            <div class="dynamic-item" data-id="${link.id}">
                <input type="text" class="admin-input" placeholder="Label" value="${link.label}" data-field="label">
                <input type="text" class="admin-input" placeholder="URL" value="${link.url}" data-field="url">
                <button class="delete-btn" onclick="deleteItem(this)">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
                </button>
            </div>
        `).join('');
    }

    function renderPinnedMessages(messages: Array<{ id: string; text: string; type: string }>) {
        const container = document.getElementById('pinned-messages-container');
        if (!container) return;
        container.innerHTML = messages.map(msg => `
            <div class="dynamic-item" data-id="${msg.id}">
                <input type="text" class="admin-input flex-1" placeholder="Message text" value="${msg.text}" data-field="text">
                <select class="admin-input w-32" data-field="type">
                    <option value="info" ${msg.type === 'info' ? 'selected' : ''}>Info</option>
                    <option value="success" ${msg.type === 'success' ? 'selected' : ''}>Success</option>
                    <option value="warning" ${msg.type === 'warning' ? 'selected' : ''}>Warning</option>
                    <option value="danger" ${msg.type === 'danger' ? 'selected' : ''}>Danger</option>
