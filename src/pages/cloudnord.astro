---
import PortfolioLayout from '../layouts/PortfolioLayout.astro';

const affiliateLink = 'https://cloudnord.net/aff.php?code=ujzheHhtMn8FuTLx';
const statusLink = 'https://status.cloudnord.net/report/uptime/6f4eed81d1661aad22de6cf2b43dfc5d/';
const reviewsLink = 'https://www.trustpilot.com/review/cloudnord.net';
---

<PortfolioLayout
    title="CloudNord | Game Server Hosting"
    description="Explore CloudNord game server hosting, uptime, features, locations, and independent customer reviews through TazElite's affiliate link."
    image="/images/cloudnord/game-banner.png"
>
    <div class="cloud-page">
        <div class="cloud-grid" aria-hidden="true"></div>

        <section class="cloud-hero" aria-labelledby="cloud-title">
            <div class="hero-copy reveal reveal-1">
                <div class="eyebrow"><i></i>CloudNord</div>
                <img class="cloud-logo" src="/images/cloudnord/logo.png" alt="CloudNord" width="600" height="171" />
                <h1 id="cloud-title">CloudNord</h1>
                <p class="service-subtitle">Game Server Hosting</p>
                <h2 class="hero-statement">Launch the world.<br /><span>Skip the server headache.</span></h2>
                <p>CloudNord provides managed game servers for communities that want quick setup, low-latency locations, mod support, DDoS protection, and a control panel that does not require a networking degree.</p>
                <div class="hero-actions">
                    <a class="launch-button" href={affiliateLink} target="_blank" rel="sponsored noopener noreferrer">
                        Launch a CloudNord server
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
                    </a>
                    <a class="status-button" href={statusLink} target="_blank" rel="noopener noreferrer">
                        <i></i> View live status
                    </a>
                </div>
                <p class="affiliate-note">Affiliate disclosure: TazElite may earn a commission from purchases through this link, at no additional cost to you.</p>
            </div>

            <div class="hero-console reveal reveal-2" aria-label="CloudNord hosting overview">
                <div class="console-topbar">
                    <span><i></i><i></i><i></i></span>
                    <strong>SERVER CONTROL / LIVE</strong>
                    <small>CN-01</small>
                </div>
                <div class="console-art">
                    <img src="/images/cloudnord/game-banner.png" alt="Minecraft server world artwork from CloudNord" width="1500" height="500" />
                    <div class="console-art-overlay"></div>
                    <div class="server-status"><i></i><span><small>Instance status</small><strong>Ready to deploy</strong></span></div>
                </div>
                <div class="console-stats">
                    <div><span>Uptime guarantee</span><strong>99.9%</strong><small>Official site-wide claim</small></div>
                    <div><span>Network reach</span><strong>15+</strong><small>Global locations</small></div>
                    <div><span>Setup</span><strong>Fast</strong><small>Automated deployment</small></div>
                </div>
            </div>
        </section>

        <section class="signal-strip" aria-label="CloudNord highlights">
            <div><span>4.8<small>/5</small></span><p><strong>Trustpilot rating</strong>Based on 600 reviews checked July 23, 2026</p></div>
            <div><span>99.9<small>%</small></span><p><strong>Uptime guarantee</strong>Published for CloudNord game server hosting</p></div>
            <div><span>3<small> days</small></span><p><strong>Refund window</strong>Try the service with a short evaluation period</p></div>
            <div><span>24<small>/7</small></span><p><strong>Server availability</strong>Hosting and support designed for always-on worlds</p></div>
        </section>

        <section class="why-section" aria-labelledby="why-heading">
            <div class="section-heading">
                <span>Why it fits gaming communities</span>
                <h2 id="why-heading">Hosting that keeps the control panel out of the way.</h2>
                <p>The best server host is the one your members barely notice: stable when everyone logs in, responsive when mods change, and straightforward when an admin needs to fix something quickly.</p>
            </div>

            <div class="feature-layout">
                <article class="feature-primary">
                    <span class="feature-index">01 / PERFORMANCE</span>
                    <svg viewBox="0 0 64 64" aria-hidden="true"><path d="M10 45a23 23 0 1144 0M32 17v6m15-1l-4 5M17 22l4 5m11 13l12-12"/></svg>
                    <h3>Global locations for lower latency</h3>
                    <p>Choose from more than 15 locations across North America, Europe, Asia-Pacific, and South America to place the server closer to your players.</p>
                </article>

                <div class="feature-stack">
                    <article><span>02</span><div><h3>DDoS protection included</h3><p>Network protection helps absorb malicious traffic before it turns game night into downtime.</p></div></article>
                    <article><span>03</span><div><h3>Modpacks without manual rebuilds</h3><p>One-click modpack installation and switching make it easier to refresh a Minecraft community.</p></div></article>
                    <article><span>04</span><div><h3>Backups and full file access</h3><p>Manage files, schedules, settings, and backups through the panel when deeper control is needed.</p></div></article>
                    <article><span>05</span><div><h3>Hardware that scales with the world</h3><p>Upgrade resources as maps, mods, automation, and active player counts become more demanding.</p></div></article>
                </div>
            </div>
        </section>

        <section class="games-section" aria-labelledby="games-heading">
            <div class="games-heading">
                <div><span>Supported worlds</span><h2 id="games-heading">One host. More than one obsession.</h2></div>
                <p>CloudNord offers managed hosting across survival, sandbox, automation, and multiplayer community games.</p>
            </div>
            <div class="game-rail" aria-label="Examples of supported games">
                <span>Minecraft</span><span>Hytale</span><span>Palworld</span><span>Terraria</span><span>Rust</span><span>Valheim</span><span>ARK</span><span>Factorio</span><span>Satisfactory</span><span>Project Zomboid</span><span>FiveM</span>
            </div>
            <div class="hosting-fit">
                <div><small>Best for</small><strong>Friend groups</strong><p>Get a persistent shared world without leaving one player’s PC running.</p></div>
                <div><small>Best for</small><strong>Discord communities</strong><p>Build recurring events around a server your moderators can manage together.</p></div>
                <div><small>Best for</small><strong>Modded play</strong><p>Give larger modpacks dedicated resources and easier configuration access.</p></div>
            </div>
        </section>

        <section class="uptime-section" aria-labelledby="uptime-heading">
            <div class="uptime-visual" aria-hidden="true">
                <div class="uptime-ring"><span>99.9<small>%</small></span><p>published guarantee</p></div>
                <svg viewBox="0 0 520 130"><path class="chart-grid" d="M0 25h520M0 65h520M0 105h520"/><path class="chart-line" d="M0 82L45 78l30 4 34-9 42 5 36-2 32 6 38-10 45 5 38-3 46 6 35-8 44 4 55-5"/></svg>
            </div>
            <div class="uptime-copy">
                <span class="section-label">Uptime, explained</span>
                <h2 id="uptime-heading">A guarantee is useful. A public status page is better.</h2>
                <p>CloudNord publishes a <strong>99.9% uptime guarantee</strong> for game server hosting and provides a public monitoring page. At exactly 99.9%, the theoretical allowance is roughly 44 minutes in a 30-day month, although provider terms determine how uptime is measured and credited.</p>
                <div class="uptime-actions">
                    <a href={statusLink} target="_blank" rel="noopener noreferrer">Open CloudNord status <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14 5h5v5M19 5l-8 8M10 6H5v13h13v-5"/></svg></a>
                    <span><i></i> Check live status before ordering</span>
                </div>
            </div>
        </section>

        <section class="reviews-section" aria-labelledby="reviews-heading">
            <div class="review-summary">
                <span class="section-label">Independent customer reviews</span>
                <h2 id="reviews-heading">High marks—with real-world context.</h2>
                <p>CloudNord’s Trustpilot profile was rated <strong>4.8 out of 5</strong> from <strong>600 reviews</strong> on July 23, 2026. Most reviews praise performance, value, the panel, and responsive support; a small minority report slower ticket handling or backup frustrations.</p>
                <a href={reviewsLink} target="_blank" rel="noopener noreferrer">Read every review on Trustpilot <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
            </div>

            <div class="review-cards">
                <article>
                    <div class="stars" aria-label="5 out of 5 stars">★★★★★</div>
                    <blockquote>“I've had zero issues from day 1.”</blockquote>
                    <p>A verified Minecraft customer highlighted smooth performance, fast support, and solid pricing after trying multiple providers.</p>
                    <footer><strong>JR</strong><span>Verified review · July 18, 2026</span></footer>
                </article>
                <article>
                    <div class="stars" aria-label="5 out of 5 stars">★★★★★</div>
                    <blockquote>“The panel is intuitive and easy to use.”</blockquote>
                    <p>A verified customer praised quick responses, useful plan upgrades, and a control panel that stayed approachable.</p>
                    <footer><strong>JL</strong><span>Verified review · July 7, 2026</span></footer>
                </article>
                <article>
                    <div class="stars" aria-label="5 out of 5 stars">★★★★★</div>
                    <blockquote>“fast hardware for a good price.”</blockquote>
                    <p>A long-term customer pointed to consistent uptime and strong value, while noting that support sometimes took longer.</p>
                    <footer><strong>Happy Customer</strong><span>Verified review · July 12, 2026</span></footer>
                </article>
            </div>

            <p class="review-disclaimer">Review excerpts are short quotations from CloudNord’s public Trustpilot profile. Ratings and review counts can change over time.</p>
        </section>

        <section class="final-cta" aria-labelledby="cta-heading">
            <div class="cta-copy">
                <span>Ready when your community is</span>
                <h2 id="cta-heading">Give the next world a proper home.</h2>
                <p>Choose a nearby location, pick the resources your game needs, and scale the server as the community grows.</p>
            </div>
            <a href={affiliateLink} target="_blank" rel="sponsored noopener noreferrer">View CloudNord plans <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
        </section>

        <aside class="service-disclaimer" aria-label="CloudNord service note">
            <p><strong>Important:</strong> Hosting performance varies by game, mods, plan resources, server location, and player connections. Review CloudNord’s current pricing, refund terms, uptime policy, and service terms before purchasing.</p>
        </aside>
    </div>
</PortfolioLayout>

<style>
    .cloud-page {
        --navy: #11182a;
        --panel: #171f34;
        --panel-light: #202b47;
        --ice: #dfe9ff;
        --blue: #7598ff;
        --blue-strong: #557cff;
        --green: #6bd5a0;
        --muted: #8e9ab3;
        --line: rgba(160, 180, 222, 0.16);
        position: relative;
        isolation: isolate;
        padding: 6.5rem 0 3rem;
        color: #f5f7fb;
    }

    .cloud-grid { position: absolute; z-index: -2; inset: 0; opacity: 0.17; background-image: linear-gradient(rgba(134, 155, 202, 0.13) 1px, transparent 1px), linear-gradient(90deg, rgba(134, 155, 202, 0.13) 1px, transparent 1px); background-size: 48px 48px; mask-image: linear-gradient(to bottom, black, transparent 38%); }
    .cloud-page::before { content: ''; position: absolute; z-index: -1; width: 42rem; height: 42rem; left: -18rem; top: -12rem; border-radius: 50%; background: radial-gradient(circle, rgba(75, 108, 205, 0.2), transparent 70%); }

    h1, h2, h3, p { margin-top: 0; }
    .cloud-hero { display: grid; grid-template-columns: minmax(0, 0.9fr) minmax(28rem, 1.1fr); gap: 4rem; align-items: center; min-height: 38rem; }
    .eyebrow, .section-label, .section-heading > span, .games-heading span, .cta-copy > span { color: #8eabff; font-size: 0.68rem; font-weight: 800; letter-spacing: 0.16em; text-transform: uppercase; }
    .eyebrow { display: flex; align-items: center; gap: 0.6rem; margin-bottom: 1.3rem; }
    .eyebrow i { width: 1.6rem; height: 1px; background: #789aff; box-shadow: 0 0 12px rgba(117, 152, 255, 0.7); }
    .cloud-logo { width: 13rem; height: auto; margin-bottom: 1.3rem; object-fit: contain; object-position: left; }
    .hero-copy h1 { margin-bottom: 1.4rem; font-family: 'Cinzel', Georgia, serif; font-size: clamp(2.7rem, 5.7vw, 5.2rem); line-height: 0.98; letter-spacing: -0.045em; text-wrap: balance; }
    .hero-copy h1 span { color: #96adf2; }
    .hero-copy > p:not(.affiliate-note) { max-width: 39rem; color: #b0bad0; font-size: 1.02rem; line-height: 1.75; }
    .hero-actions { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 2rem; }
    .hero-actions a, .final-cta > a { display: inline-flex; align-items: center; justify-content: center; gap: 0.6rem; min-height: 3.2rem; padding: 0 1.25rem; border-radius: 0.55rem; font-size: 0.82rem; font-weight: 800; text-decoration: none; transition: transform 180ms ease, background 180ms ease, border-color 180ms ease; }
    .hero-actions a:hover, .final-cta > a:hover { transform: translateY(-2px); }
    .hero-actions svg, .final-cta svg, .review-summary svg { width: 1rem; fill: none; stroke: currentColor; stroke-width: 1.8; }
    .launch-button { color: white; background: #5b7ff2; box-shadow: 0 16px 36px rgba(55, 86, 185, 0.3); }
    .launch-button:hover { background: #6c8df5; }
    .status-button { color: #d9e2f5; border: 1px solid rgba(162, 181, 221, 0.24); background: rgba(25, 34, 56, 0.68); }
    .status-button i, .uptime-actions span i { width: 7px; height: 7px; border-radius: 50%; background: var(--green); box-shadow: 0 0 0 5px rgba(107, 213, 160, 0.1); }
    .affiliate-note { max-width: 39rem; margin-top: 0.85rem; color: #66728a; font-size: 0.65rem; line-height: 1.5; }

    .hero-console { border: 1px solid rgba(147, 170, 220, 0.25); border-radius: 0.9rem; overflow: hidden; background: #111829; box-shadow: 0 34px 75px rgba(0, 0, 0, 0.45); transform: perspective(1100px) rotateY(-3deg); }
    .console-topbar { display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; min-height: 2.5rem; padding: 0 0.9rem; border-bottom: 1px solid var(--line); color: #71809d; background: #161e31; font-size: 0.55rem; letter-spacing: 0.12em; }
    .console-topbar > span { display: flex; gap: 0.35rem; }
    .console-topbar > span i { width: 7px; height: 7px; border-radius: 50%; background: #4d5c77; }
    .console-topbar > span i:first-child { background: #d56b77; }
    .console-topbar > span i:nth-child(2) { background: #d8b060; }
    .console-topbar > span i:last-child { background: #66c99a; }
    .console-topbar small { justify-self: end; }
    .console-art { position: relative; height: 19rem; overflow: hidden; }
    .console-art img { width: 100%; height: 100%; object-fit: cover; }
    .console-art-overlay { position: absolute; inset: 0; background: linear-gradient(180deg, rgba(8, 13, 24, 0.08), rgba(8, 13, 24, 0.9)); }
    .server-status { position: absolute; left: 1.2rem; bottom: 1.2rem; display: flex; align-items: center; gap: 0.75rem; padding: 0.7rem 0.85rem; border: 1px solid rgba(133, 218, 174, 0.22); border-radius: 0.5rem; background: rgba(13, 22, 35, 0.84); backdrop-filter: blur(12px); }
    .server-status > i { width: 9px; height: 9px; border-radius: 50%; background: var(--green); box-shadow: 0 0 14px rgba(107, 213, 160, 0.75); }
    .server-status span { display: flex; flex-direction: column; }
    .server-status small { color: #77859f; font-size: 0.53rem; }
    .server-status strong { color: #e9fff3; font-size: 0.72rem; }
    .console-stats { display: grid; grid-template-columns: repeat(3, 1fr); }
    .console-stats > div { padding: 1rem; }
    .console-stats > div + div { border-left: 1px solid var(--line); }
    .console-stats span, .console-stats small { display: block; color: #697791; font-size: 0.54rem; }
    .console-stats strong { display: block; margin: 0.25rem 0 0.15rem; color: #e8efff; font-family: 'Cinzel', Georgia, serif; font-size: 1.15rem; }

    .signal-strip { display: grid; grid-template-columns: repeat(4, 1fr); margin: 5rem 0 7rem; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }
    .signal-strip > div { display: grid; grid-template-columns: auto 1fr; gap: 0.8rem; align-items: center; padding: 1.4rem 1.2rem; }
    .signal-strip > div + div { border-left: 1px solid var(--line); }
    .signal-strip > div > span { color: #eaf0ff; font-family: 'Cinzel', Georgia, serif; font-size: 1.35rem; }
    .signal-strip small { color: #7f8ca6; font-size: 0.62rem; }
    .signal-strip p { margin: 0; color: #6f7c95; font-size: 0.61rem; line-height: 1.4; }
    .signal-strip strong { display: block; color: #bec9de; font-size: 0.7rem; }

    .why-section { padding-bottom: 7rem; }
    .section-heading { display: grid; grid-template-columns: 0.9fr 1.1fr; gap: 1.5rem 4rem; align-items: end; margin-bottom: 3rem; }
    .section-heading > span { grid-column: 1 / -1; }
    .section-heading h2, .games-heading h2, .uptime-copy h2, .review-summary h2, .cta-copy h2 { margin: 0; font-family: 'Cinzel', Georgia, serif; font-size: clamp(1.9rem, 4vw, 3.25rem); line-height: 1.1; letter-spacing: -0.03em; text-wrap: balance; }
    .section-heading p, .games-heading p { margin: 0; color: #8996ae; line-height: 1.7; }
    .feature-layout { display: grid; grid-template-columns: 0.75fr 1.25fr; border: 1px solid var(--line); }
    .feature-primary { padding: 2.5rem; background: linear-gradient(145deg, rgba(72, 101, 181, 0.22), rgba(23, 31, 52, 0.7)); }
    .feature-index { color: #7794e8; font-size: 0.57rem; font-weight: 800; letter-spacing: 0.12em; }
    .feature-primary svg { width: 4rem; margin: 3.8rem 0 2.5rem; fill: none; stroke: #8daaff; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
    .feature-primary h3 { font-size: 1.2rem; }
    .feature-primary p { margin: 0; color: #8e9bb3; font-size: 0.8rem; line-height: 1.7; }
    .feature-stack { display: grid; grid-template-columns: 1fr 1fr; border-left: 1px solid var(--line); }
    .feature-stack article { display: grid; grid-template-columns: auto 1fr; gap: 0.8rem; padding: 1.8rem; border-right: 1px solid var(--line); border-bottom: 1px solid var(--line); }
    .feature-stack span { color: #60708e; font-size: 0.58rem; font-weight: 800; }
    .feature-stack h3 { margin-bottom: 0.45rem; font-size: 0.9rem; }
    .feature-stack p { margin: 0; color: #7d899f; font-size: 0.73rem; line-height: 1.6; }

    .games-section { padding: 5rem 0 7rem; border-top: 1px solid var(--line); }
    .games-heading { display: grid; grid-template-columns: 1fr 0.8fr; gap: 4rem; align-items: end; }
    .games-heading span { display: block; margin-bottom: 0.8rem; }
    .game-rail { display: flex; gap: 0.65rem; margin: 3rem 0; padding: 1rem 0; overflow-x: auto; scrollbar-width: thin; scrollbar-color: #425479 transparent; }
    .game-rail span { flex: 0 0 auto; padding: 0.75rem 1rem; border: 1px solid var(--line); border-radius: 999px; color: #b5c1d8; background: rgba(26, 35, 58, 0.58); font-size: 0.72rem; font-weight: 700; }
    .hosting-fit { display: grid; grid-template-columns: 1.15fr 0.85fr 1fr; border-top: 1px solid var(--line); border-left: 1px solid var(--line); }
    .hosting-fit > div { min-height: 10rem; padding: 1.5rem; border-right: 1px solid var(--line); border-bottom: 1px solid var(--line); }
    .hosting-fit small { color: #66748f; font-size: 0.55rem; text-transform: uppercase; letter-spacing: 0.12em; }
    .hosting-fit strong { display: block; margin: 1.4rem 0 0.4rem; color: #e7edfa; }
    .hosting-fit p { margin: 0; color: #7f8ca3; font-size: 0.72rem; line-height: 1.6; }

    .uptime-section { display: grid; grid-template-columns: 1fr 1fr; gap: 5rem; align-items: center; padding: 5rem 4rem; border: 1px solid rgba(107, 213, 160, 0.19); border-radius: 1rem; background: linear-gradient(125deg, rgba(18, 39, 43, 0.8), rgba(17, 24, 41, 0.9)); overflow: hidden; }
    .uptime-visual { position: relative; min-height: 20rem; display: grid; place-items: center; }
    .uptime-ring { display: grid; place-content: center; width: 13rem; height: 13rem; border: 1px solid rgba(107, 213, 160, 0.4); border-radius: 50%; text-align: center; box-shadow: 0 0 0 2.5rem rgba(107, 213, 160, 0.035), 0 0 0 5rem rgba(107, 213, 160, 0.02); }
    .uptime-ring span { color: #dffff0; font-family: 'Cinzel', Georgia, serif; font-size: 2.8rem; }
    .uptime-ring small { color: #79dbaa; font-size: 0.9rem; }
    .uptime-ring p { margin: 0.2rem 0 0; color: #6b9c83; font-size: 0.55rem; text-transform: uppercase; letter-spacing: 0.1em; }
    .uptime-visual > svg { position: absolute; inset: auto -4rem 0; width: calc(100% + 8rem); height: 8rem; fill: none; }
    .chart-grid { stroke: rgba(126, 157, 144, 0.09); }
    .chart-line { stroke: #63d197; stroke-width: 2; filter: drop-shadow(0 0 7px rgba(99, 209, 151, 0.4)); }
    .uptime-copy h2 { margin-top: 0.7rem; }
    .uptime-copy > p { margin: 1.2rem 0 0; color: #95a3b7; line-height: 1.75; }
    .uptime-copy > p strong { color: #c9f3dc; }
    .uptime-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 1.2rem; margin-top: 1.6rem; }
    .uptime-actions a { display: inline-flex; align-items: center; gap: 0.45rem; color: #9fe7c1; font-size: 0.74rem; font-weight: 800; text-decoration: none; }
    .uptime-actions a:hover { color: white; }
    .uptime-actions svg { width: 1rem; fill: none; stroke: currentColor; stroke-width: 1.7; }
    .uptime-actions span { display: flex; align-items: center; gap: 0.55rem; color: #6d887b; font-size: 0.63rem; }

    .reviews-section { padding: 8rem 0 7rem; }
    .review-summary { display: grid; grid-template-columns: 1fr 0.9fr; column-gap: 4rem; align-items: end; margin-bottom: 3rem; }
    .review-summary .section-label { grid-column: 1 / -1; margin-bottom: 0.8rem; }
    .review-summary > p { margin: 0; color: #8b98ae; line-height: 1.7; }
    .review-summary > p strong { color: #d9e2f3; }
    .review-summary > a { grid-column: 2; display: inline-flex; align-items: center; gap: 0.45rem; margin-top: 1rem; color: #9fb4ed; font-size: 0.72rem; font-weight: 800; text-decoration: none; }
    .review-cards { display: grid; grid-template-columns: 1.1fr 0.9fr 1fr; border-top: 1px solid var(--line); border-left: 1px solid var(--line); }
    .review-cards article { display: flex; flex-direction: column; min-height: 20rem; padding: 1.7rem; border-right: 1px solid var(--line); border-bottom: 1px solid var(--line); background: rgba(20, 28, 47, 0.62); }
    .stars { color: #73d5a1; font-size: 0.8rem; letter-spacing: 0.08em; }
    .review-cards blockquote { margin: 2.2rem 0 1rem; color: #f0f4fc; font-family: 'Cinzel', Georgia, serif; font-size: 1.12rem; line-height: 1.45; }
    .review-cards p { color: #7f8da4; font-size: 0.74rem; line-height: 1.65; }
    .review-cards footer { display: flex; flex-direction: column; margin-top: auto; }
    .review-cards footer strong { color: #dce5f5; font-size: 0.72rem; }
