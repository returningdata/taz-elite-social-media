---
import PortfolioLayout from '../layouts/PortfolioLayout.astro';
import BrandLogo from '../components/brand/BrandLogo.astro';
import PlatformIcon from '../components/brand/PlatformIcon.astro';
import DiscordPresence from '../components/DiscordPresence.astro';
import DiscordServerCard from '../components/integrations/DiscordServerCard.astro';

const rustServers = [
  { name: 'STARZ S1 QUADS', region: 'North America', cadence: 'Weekly', id: '15aa2e4' },
  { name: 'STARZ S2 DUO', region: 'North America', cadence: 'Weekly', id: '43bbc90' },
  { name: 'STARZ S3 6X', region: 'North America', cadence: 'Weekly', id: 'eee96de' },
  { name: 'STARZ S4 QUADS', region: 'Europe', cadence: 'Weekly', id: 'f4db6cb' },
  { name: 'STARZ S5 VANILLA+', region: 'North America', cadence: 'Bi-weekly', id: 'obfebfa' }
];

const timeline = [
  { community: 'Starz Empire', roles: ['Head Administrator'], status: 'Retired', date: 'February 15, 2025 – July 25, 2025' },
  { community: 'California Roleplay', roles: ['Junior Head Administrator', "Frank's Assistant"], status: 'Retired', date: 'February 28, 2026' },
  { community: 'Del Perro Police Department', roles: ['Chief of Police (01)'], status: 'Retired', date: 'February 28, 2026' },
  { community: 'Internal Affairs Agency', roles: ['Agency leadership and oversight'], status: 'Retired', date: 'Previous community experience' }
];
---
<PortfolioLayout title="Discord Community Hub | Taz Elite" description="View Taz’s live Discord presence, community information, Rust servers, and previous community leadership experience.">
  <header class="page-shell discord-hero">
    <div class="discord-hero-logo"><BrandLogo size="large" eager /></div>
    <div><span class="page-kicker">Discord profile and community hub</span><h1>Taz</h1><p class="discord-role-line">Software Developer • Community Leader • Content Creator • U.S. Army</p><p>I build secure community systems, lead online teams, and connect gaming communities with reliable Discord automation and web platforms.</p><div class="button-row"><a class="button primary" href="https://discord.gg/T3AeBNQdXp" target="_blank" rel="noopener noreferrer"><PlatformIcon name="discord" size={18} /> Join Community</a><a class="button" href="#starz">Explore Rust Servers</a></div></div>
  </header>

  <section class="section"><div class="section-shell discord-profile-grid"><DiscordPresence userId="1000470631688712243" /><DiscordServerCard invite="T3AeBNQdXp" title="The Elite Outpost" description="Taz’s featured Discord community for gaming, technology, content, and community updates." featured /></div></section>

  <section class="section" id="starz"><div class="section-shell"><header class="section-heading" data-reveal><span>Starz Empire · Rust Console</span><h2>Five live communities. One weekly rhythm.</h2><p>Current STARZ servers wipe every Thursday. Live Discord counts come from Discord’s public invite preview and remain separate from the static server schedule.</p></header><div class="discord-profile-grid starz-feature"><DiscordServerCard invite="starz" title="STARZ" description="The official STARZ Rust Console community." featured /><article class="starz-store"><PlatformIcon name="store" size={34} /><span>OFFICIAL STORE</span><h3>STARZ Empire Store</h3><p>Open the authorized STARZ Empire store for community purchases and server support.</p><a href="https://starzempire.tip4serv.com/" target="_blank" rel="noopener noreferrer">Open Store ↗</a></article></div><div class="rust-server-grid">{rustServers.map((server) => <article class="rust-server-card" data-reveal><div class="rust-icon"><PlatformIcon name="rust" size={28} /></div><span>{server.region}</span><h3>{server.name}</h3><dl><div><dt>Schedule</dt><dd>{server.cadence}</dd></div><div><dt>Wipe</dt><dd>Every Thursday</dd></div><div><dt>Server ID</dt><dd><code>{server.id}</code></dd></div></dl><div><a href="https://discord.gg/starz" target="_blank" rel="noopener noreferrer">Join Discord</a><a href="https://starzempire.tip4serv.com/" target="_blank" rel="noopener noreferrer">Store</a></div></article>)}</div></div></section>

  <section class="section"><div class="section-shell"><header class="section-heading" data-reveal><span>Previous community experience</span><h2>Leadership built through service.</h2><p>A professional timeline of retired community and department roles.</p></header><div class="community-timeline">{timeline.map((entry) => <article data-reveal><i></i><div><span>{entry.date}</span><h3>{entry.community}</h3>{entry.roles.map((role) => <p>{role}</p>)}<strong>{entry.status}</strong></div></article>)}</div></div></section>

  <section class="section"><div class="section-shell"><header class="section-heading" data-reveal><span>Featured project and community</span><h2>California Roleplay</h2><p>Direct links to the community, FiveM server, and authorized stores.</p></header><div class="california-grid"><DiscordServerCard invite="calirp" title="California Roleplay" description="A large FiveM roleplay community with live public Discord counts." featured /><div class="community-link-grid"><a href="https://cfx.re/join/ajv9r5" target="_blank" rel="noopener noreferrer"><PlatformIcon name="server" size={28} /><span>FiveM Server</span><strong>Connect to California Roleplay</strong></a><a href="https://store.calirp.gg" target="_blank" rel="noopener noreferrer"><PlatformIcon name="store" size={28} /><span>Community Store</span><strong>Open the official store</strong></a><a href="https://devops-store.calirp.gg" target="_blank" rel="noopener noreferrer"><PlatformIcon name="activity" size={28} /><span>DevOps Store</span><strong>Open DevOps services</strong></a></div></div></div></section>
</PortfolioLayout>

<style>
  .discord-hero{display:grid;grid-template-columns:minmax(240px,.7fr) minmax(0,1.3fr);align-items:center;gap:clamp(2rem,6vw,5rem);padding-block:clamp(3rem,8vw,7rem)}.discord-hero-logo{max-width:420px;filter:drop-shadow(0 25px 60px rgba(88,101,242,.24))}.discord-hero h1{margin:.5rem 0;font-family:'Space Grotesk',sans-serif;font-size:clamp(4rem,10vw,7rem);line-height:.9}.discord-hero>div>p{max-width:680px;color:#aeb9cd;line-height:1.75}.discord-role-line{color:#dce4f4!important;font-weight:700}.discord-profile-grid{display:grid;grid-template-columns:1fr 1fr;gap:1rem}.starz-feature{margin-bottom:1rem}.starz-store{display:flex;min-width:0;flex-direction:column;align-items:flex-start;justify-content:center;padding:clamp(1.2rem,4vw,2rem);border:1px solid rgba(232,116,65,.25);border-radius:18px;background:linear-gradient(145deg,rgba(129,56,25,.18),rgba(8,12,24,.85))}.starz-store>span{margin-top:1rem;color:#ffad72;font-size:.68rem;font-weight:800;letter-spacing:.13em}.starz-store h3{margin:.5rem 0;font-family:'Space Grotesk',sans-serif;font-size:1.7rem}.starz-store p{color:#aeb9cd;line-height:1.65}.starz-store a{padding:.75rem .9rem;border:1px solid rgba(255,151,92,.3);border-radius:9px;color:white;text-decoration:none}.rust-server-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:.8rem}.rust-server-card{min-width:0;padding:1.1rem;border:1px solid rgba(218,117,69,.2);border-radius:15px;background:linear-gradient(145deg,rgba(86,42,23,.13),rgba(7,11,22,.8))}.rust-icon{display:grid;width:48px;height:48px;place-items:center;border:1px solid rgba(232,116,65,.3);border-radius:13px;color:#ff9b64;background:rgba(232,116,65,.09)}.rust-server-card>span{display:block;margin-top:1rem;color:#ff9b64;font-size:.65rem;font-weight:800;text-transform:uppercase;letter-spacing:.11em}.rust-server-card h3{margin:.4rem 0 1rem;font-family:'Space Grotesk',sans-serif}.rust-server-card dl{display:grid;gap:.45rem;margin:0}.rust-server-card dl div{display:flex;justify-content:space-between;gap:.6rem;padding-bottom:.4rem;border-bottom:1px solid rgba(255,255,255,.07)}.rust-server-card dt{color:#8f9bb0;font-size:.7rem}.rust-server-card dd{margin:0;color:#d9e1ef;font-size:.72rem;text-align:right;overflow-wrap:anywhere}.rust-server-card code{font-size:.7rem}.rust-server-card>div:last-child{display:flex;flex-wrap:wrap;gap:.45rem;margin-top:1rem}.rust-server-card a{min-height:42px;padding:.65rem .7rem;border:1px solid rgba(232,116,65,.25);border-radius:8px;color:white;font-size:.7rem;text-decoration:none}.community-timeline{position:relative;max-width:820px;margin-inline:auto}.community-timeline:before{content:"";position:absolute;left:13px;top:0;bottom:0;width:1px;background:linear-gradient(#7289da,#956cff,transparent)}.community-timeline article{position:relative;padding:0 0 2rem 3.2rem}.community-timeline article>i{position:absolute;left:5px;top:5px;width:17px;height:17px;border:3px solid #0a0f1f;border-radius:50%;background:#7289da;box-shadow:0 0 18px rgba(114,137,218,.5)}.community-timeline article>div{padding:1.1rem;border:1px solid rgba(114,137,218,.18);border-radius:14px;background:rgba(9,14,29,.7)}.community-timeline span{color:#9ca9ff;font-size:.68rem;font-weight:800;letter-spacing:.08em}.community-timeline h3{margin:.4rem 0;font-family:'Space Grotesk',sans-serif}.community-timeline p{margin:.3rem 0;color:#b1bbcd}.community-timeline strong{display:inline-block;margin-top:.55rem;padding:.3rem .5rem;border-radius:999px;background:rgba(255,255,255,.06);color:#929db0;font-size:.65rem}.california-grid{display:grid;grid-template-columns:1fr 1fr;gap:1rem}.community-link-grid{display:grid;gap:.7rem}.community-link-grid a{display:grid;grid-template-columns:auto 1fr;gap:.2rem .8rem;align-items:center;padding:1rem;border:1px solid rgba(114,137,218,.18);border-radius:14px;background:rgba(9,14,29,.72);text-decoration:none}.community-link-grid svg{grid-row:1/3;color:#9ca9ff}.community-link-grid span{color:#909cb0;font-size:.68rem}.community-link-grid strong{color:white}.button svg{margin-right:.35rem}@media(max-width:900px){.discord-hero,.discord-profile-grid,.california-grid{grid-template-columns:1fr}.discord-hero-logo{max-width:300px;margin-inline:auto}.rust-server-grid{grid-template-columns:repeat(2,1fr)}}@media(max-width:560px){.discord-hero{padding-top:2rem}.discord-hero-logo{max-width:220px}.rust-server-grid{grid-template-columns:1fr}.community-timeline article{padding-left:2.7rem}.community-link-grid a{grid-template-columns:32px 1fr}}
</style>
