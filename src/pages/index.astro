---
import PortfolioLayout from '../layouts/PortfolioLayout.astro';
import SectionHeading from '../components/portfolio/SectionHeading.astro';
import SocialCard from '../components/portfolio/SocialCard.astro';
import { siteConfig } from '../config/site';
import { biography, identity, pillars, approvedPhotos } from '../data/content';
import BrandLogo from '../components/brand/BrandLogo.astro';
---
<PortfolioLayout>
  <section class="page-shell hero">
    <div>
      <div class="hero-brand-lockup"><BrandLogo size="small" eager /><span class="eyebrow">Operator · Developer · Founder · Creator</span></div>
      <h1>Taz <span>Elite</span></h1>
      <p class="hero-subtitle">Software Developer • Technology Entrepreneur • U.S. Army • Content Creator</p>
      <p class="hero-support">Building secure, professional, and innovative digital experiences through technology, discipline, and creativity.</p>
      <div class="button-row">
        <a class="button primary" href="/about">About Me</a><a class="button" href="/experience">View My Experience</a><a class="button" href="/projects">Explore My Projects</a><a class="button" href="/youtube">Watch My Content</a><a class="button" href={siteConfig.socials.discord}>Join My Discord</a>
      </div>
      <ul class="identity-list">{identity.map((item) => <li>{item}</li>)}</ul>
    </div>
    <div class="hero-visual" data-reveal>
      <div class="hero-frame"><img src={approvedPhotos[0].src} alt={approvedPhotos[0].alt} width="576" height="576" fetchpriority="high" /></div>
      <div class="visual-label"><small>Professional identity</small><strong>Taz · Founder, Kruiger Labs</strong></div>
    </div>
  </section>

  <section class="section"><div class="section-shell">
    <SectionHeading eyebrow="My bio" title="Built at the intersection of service and innovation." description="A disciplined approach to software, infrastructure, entrepreneurship, gaming, and creator communities." />
    <div class="bio-grid">
      <aside class="bio-aside" data-reveal><blockquote>“Building the future through innovation, discipline, and technology.”</blockquote></aside>
      <div class="bio-copy">{biography.map((paragraph) => <p data-reveal>{paragraph}</p>)}</div>
    </div>
  </div></section>

  <section class="section"><div class="section-shell">
    <SectionHeading eyebrow="Operating principles" title="One identity. Multiple arenas." description="Each part of the Taz Elite brand reinforces the same focus: reliable systems, meaningful communities, and work built with purpose." />
    <div class="pillars">{pillars.map(([title, text]) => <article class="pillar" data-reveal><span>{title}</span><p>{text}</p></article>)}</div>
  </div></section>

  <section class="section"><div class="section-shell">
    <SectionHeading eyebrow="Connected platforms" title="Follow the work. Join the community." description="Verified live statistics appear when each platform integration is available. Missing data is never invented." />
    <div class="social-grid">
      <SocialCard platform="Discord" title="Taz Elite Discord" description="Community conversations, gaming, events, and direct updates." href={siteConfig.socials.discord} endpoint="/.netlify/functions/discord-presence" accent="#7289da" />
      <SocialCard platform="Twitch" title="tazeliteplays" description="Live gaming and creator streams through the existing Twitch integration." href={siteConfig.socials.twitch} endpoint="/.netlify/functions/twitch-status?username=tazeliteplays" accent="#a970ff" />
      <SocialCard platform="TikTok" title="@tazeliteplays" description="Short-form gaming and creator content from Taz Elite." href={siteConfig.socials.tiktok} endpoint="/.netlify/functions/tiktok-profile" accent="#ff4f81" />
      <SocialCard platform="YouTube" title="@tazelite-plays" description="Recent videos, channel statistics, and live-stream status." href={siteConfig.socials.youtube} endpoint="/.netlify/functions/youtube-channel" accent="#ff4545" />
      <SocialCard platform="Instagram" title="Taz Elite" description="A manually approved collection of personal and creator photos." href={siteConfig.socials.instagram} accent="#df73ff" />
    </div>
  </div></section>
</PortfolioLayout>
