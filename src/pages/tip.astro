---
import Layout from '../layouts/Layout.astro';
import SiteHeader from '../components/SiteHeader.astro';
---

<Layout title="Support TazElite | Tip & Donate">
    <SiteHeader />

    <div class="pt-16 flex flex-col items-center text-center">
        <div class="mb-8 mt-8">
            <div class="tip-icon-glow">
                <svg class="w-20 h-20 text-red-500" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/>
                </svg>
            </div>
        </div>

        <h1 class="stranger-things-title text-3xl sm:text-5xl mb-4">Support TazElite</h1>
        <p class="text-xl text-gray-300 mb-2 max-w-xl">
            Your support keeps the streams going and the community growing
        </p>
        <p class="text-sm text-red-400 mb-10 tracking-widest uppercase">
            Every bit counts
        </p>

        <div class="divider"></div>

        <section class="w-full max-w-lg mb-12 mt-8">
            <a
                href="https://streamlabs.com/tazeliteplays/tip"
                target="_blank"
                rel="noopener noreferrer"
                class="tip-main-btn"
            >
                <div class="tip-btn-icon">
                    <svg class="w-10 h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                    </svg>
                </div>
                <div class="flex flex-col text-left">
                    <span class="text-xl font-bold text-white">Send a Tip</span>
                    <span class="text-sm text-gray-400">Support via Streamlabs</span>
                </div>
                <svg class="w-5 h-5 text-gray-400 ml-auto" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
                </svg>
            </a>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mt-6">
                <div class="card text-center">
                    <div class="text-3xl mb-3">🎮</div>
                    <h3 class="text-base font-semibold mb-1 text-red-400">Better Streams</h3>
                    <p class="text-xs text-gray-400">Help upgrade equipment and improve stream quality</p>
                </div>
                <div class="card text-center">
                    <div class="text-3xl mb-3">🎉</div>
                    <h3 class="text-base font-semibold mb-1 text-red-400">Community Events</h3>
                    <p class="text-xs text-gray-400">Fund giveaways, tournaments, and community events</p>
                </div>
            </div>
        </section>

        <div class="divider"></div>

        <section class="w-full max-w-lg mb-12">
            <h2 class="stranger-things-title text-xl sm:text-2xl mb-6">How It Works</h2>
            <div class="space-y-4">
                <div class="card flex items-start gap-4 text-left">
                    <div class="tip-step-number">1</div>
                    <div>
                        <h3 class="font-semibold text-white mb-1">Click the Button</h3>
                        <p class="text-sm text-gray-400">You'll be taken to the secure Streamlabs donation page</p>
                    </div>
                </div>
                <div class="card flex items-start gap-4 text-left">
                    <div class="tip-step-number">2</div>
                    <div>
                        <h3 class="font-semibold text-white mb-1">Choose Your Amount</h3>
                        <p class="text-sm text-gray-400">Pick any amount you're comfortable with</p>
                    </div>
                </div>
                <div class="card flex items-start gap-4 text-left">
                    <div class="tip-step-number">3</div>
                    <div>
                        <h3 class="font-semibold text-white mb-1">Leave a Message</h3>
                        <p class="text-sm text-gray-400">Your message will show up on stream during live broadcasts</p>
                    </div>
                </div>
            </div>
        </section>

        <footer class="py-8 text-center text-gray-500 text-sm">
            <p>&copy; {new Date().getFullYear()} TazElite Plays. All rights reserved.</p>
            <p class="text-xs mt-2 text-red-900">From The Upside Down</p>
        </footer>
    </div>
</Layout>

<style>
    .tip-icon-glow {
        display: flex;
        align-items: center;
        justify-content: center;
        animation: tip-pulse 2s ease-in-out infinite;
    }

    @keyframes tip-pulse {
        0%, 100% {
            filter: drop-shadow(0 0 20px rgba(229, 9, 20, 0.6));
            transform: scale(1);
        }
        50% {
            filter: drop-shadow(0 0 40px rgba(229, 9, 20, 0.9));
            transform: scale(1.05);
        }
    }

    .tip-main-btn {
        display: flex;
        align-items: center;
        gap: 1rem;
        padding: 1.25rem 1.5rem;
        border-radius: 1rem;
        background: linear-gradient(135deg, rgba(229, 9, 20, 0.25), rgba(184, 28, 36, 0.15));
        border: 1px solid rgba(229, 9, 20, 0.5);
        text-decoration: none !important;
        transition: all 0.3s;
    }

    .tip-main-btn:hover {
        transform: translateY(-3px);
        background: linear-gradient(135deg, rgba(229, 9, 20, 0.35), rgba(184, 28, 36, 0.25));
        border-color: rgba(229, 9, 20, 0.8);
        box-shadow: 0 15px 40px rgba(229, 9, 20, 0.3);
    }

    .tip-btn-icon {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 56px;
        height: 56px;
        border-radius: 0.75rem;
        background: rgba(229, 9, 20, 0.2);
        color: #e50914;
        flex-shrink: 0;
    }

    .tip-step-number {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 36px;
        height: 36px;
        border-radius: 50%;
        background: rgba(229, 9, 20, 0.2);
        border: 1px solid rgba(229, 9, 20, 0.5);
        color: #e50914;
        font-weight: 700;
        font-size: 0.875rem;
        flex-shrink: 0;
    }
</style>
