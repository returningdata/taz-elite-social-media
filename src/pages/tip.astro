---
import PortfolioLayout from '../layouts/PortfolioLayout.astro';

const benefits = [
  ['Better Streams', 'Help upgrade equipment and improve stream quality.'],
  ['Community Events', 'Fund giveaways, tournaments, and community events.']
];

const steps = [
  ['Click the Button', 'Open the secure Streamlabs support page.'],
  ['Choose Your Amount', 'Pick any amount you are comfortable with.'],
  ['Leave a Message', 'Your message can appear during live broadcasts.']
];
---

<PortfolioLayout title="Support Taz Elite | Tip" description="Support Taz Elite streams, community events, and creator projects through Streamlabs.">
  <section class="page-shell page-intro support-intro">
    <span class="page-kicker">Support Taz Elite</span>
    <h1>Help the community keep building.</h1>
    <p>Your support helps improve streams, creator projects, and community events. Every contribution is optional and appreciated.</p>
    <div class="button-row">
      <a class="button primary" href="https://streamlabs.com/tazeliteplays/tip" target="_blank" rel="noopener noreferrer">Send a Tip ↗</a>
      <a class="button" href="/contact">Contact Taz</a>
    </div>
  </section>

  <section class="section">
    <div class="section-shell">
      <div class="section-heading"><span>What support helps</span><h2>Built around better experiences.</h2></div>
      <div class="support-grid">
        {benefits.map(([title, description]) => <article class="support-card"><h3>{title}</h3><p>{description}</p></article>)}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="section-shell">
      <div class="section-heading"><span>How it works</span><h2>Three simple steps.</h2></div>
      <div class="support-grid support-steps">
        {steps.map(([title, description], index) => <article class="support-card"><span class="step-number">0{index + 1}</span><h3>{title}</h3><p>{description}</p></article>)}
      </div>
    </div>
  </section>
</PortfolioLayout>

<style>
  .support-intro{max-width:920px}.support-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1rem}.support-steps{grid-template-columns:repeat(3,minmax(0,1fr))}.support-card{padding:1.4rem;border:1px solid var(--line);border-radius:16px;background:linear-gradient(145deg,rgba(15,23,47,.72),rgba(7,11,24,.66));box-shadow:inset 0 1px rgba(255,255,255,.035)}.support-card h3{margin:.5rem 0;font-family:'Space Grotesk',sans-serif}.support-card p{margin:0;color:var(--muted);line-height:1.7}.step-number{color:var(--cyan);font-size:.68rem;font-weight:800;letter-spacing:.14em}@media(max-width:760px){.support-grid,.support-steps{grid-template-columns:1fr}}
</style>
