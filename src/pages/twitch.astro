---
import TwitchStatus from '../components/TwitchStatus.astro';
import BrandLogo from '../components/brand/BrandLogo.astro';
import PlatformIcon from '../components/brand/PlatformIcon.astro';
import TazMixPlayer from '../components/TazMixPlayer.astro';
import SiteEffects from '../components/SiteEffects.astro';
import { siteConfig } from '../config/site';
import { ClientRouter } from 'astro:transitions';

const title = 'TazElitePlays Twitch | Live Streams, Gaming and Highlights';
const description = 'Watch TazElitePlays live on Twitch, explore recent broadcasts and clips, view the streaming schedule, and join the Taz Elite gaming community.';
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin);
const imageUrl = new URL(siteConfig.brand.logoLarge, Astro.site ?? Astro.url.origin);
const profileSchema = { '@context': 'https://schema.org', '@type': 'ProfilePage', name: title, description, url: canonical.href, mainEntity: { '@type': 'Person', name: 'TazElitePlays', alternateName: 'Taz Elite', image: imageUrl.href, sameAs: [siteConfig.socials.twitch, siteConfig.socials.youtube, siteConfig.socials.tiktok, siteConfig.socials.instagram, siteConfig.socials.discord] } };
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0c0814" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&family=Space+Grotesk:wght@500;600;700&display=swap" rel="stylesheet" />
    <meta property="og:type" content="profile" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <script type="application/ld+json" set:html={JSON.stringify(profileSchema)}></script>
    <ClientRouter />
  </head>
  <body>
    <SiteEffects />
    <a class="skip-link" href="#twitch-main">Skip to Twitch content</a>
    <header class="twitch-nav">
      <a class="channel-mark" href="/twitch" aria-label="TazElitePlays Twitch hub"><BrandLogo size="small" class="nav-logo" eager /><span><strong>TazElitePlays</strong><small>OFFICIAL TWITCH HUB</small></span></a>
      <nav aria-label="Twitch page navigation"><a href="#watch">Watch</a><a href="#recent-broadcasts">Broadcasts</a><a href={siteConfig.socials.discord} target="_blank" rel="noopener noreferrer">Community</a></nav>
      <a class="nav-twitch" href={siteConfig.socials.twitch} target="_blank" rel="noopener noreferrer"><PlatformIcon name="twitch" size={17} /> Follow</a>
    </header>
    <main id="twitch-main"><TwitchStatus username={siteConfig.integrations.twitchLogin} /></main>
    <footer class="twitch-footer"><a href="/" class="footer-brand"><BrandLogo size="small" class="footer-logo" /><span><strong>Taz Elite</strong><small>TazElitePlays streaming hub</small></span></a><p>Live streams, gaming content, highlights, and community.</p><div><a href={siteConfig.socials.twitch} target="_blank" rel="noopener noreferrer">Twitch</a><a href={siteConfig.socials.discord} target="_blank" rel="noopener noreferrer">Discord</a><a href="/">Main site</a></div></footer>
    <TazMixPlayer />
  </body>
</html>

<style is:global>
  :root{color-scheme:dark;font-family:'Manrope',sans-serif;background:#08060d;color:#f9f7fc}*{box-sizing:border-box}html{min-width:320px;scroll-behavior:smooth;background:#08060d}body{margin:0;min-width:320px;overflow-x:hidden;background:radial-gradient(circle at 80% 3%,rgba(145,70,255,.18),transparent 32rem),radial-gradient(circle at 10% 30%,rgba(91,200,255,.08),transparent 28rem),linear-gradient(180deg,#0c0814,#07070d 62%,#0b0712);color:#f9f7fc}a{color:inherit}.skip-link{position:fixed;top:-5rem;left:1rem;z-index:120;padding:.8rem 1rem;border-radius:.55rem;background:white;color:#100817}.skip-link:focus{top:1rem}.twitch-nav{position:sticky;top:0;z-index:60;width:min(100% - 2rem,1280px);min-height:76px;margin:0 auto;display:grid;grid-template-columns:auto 1fr auto;align-items:center;gap:1.2rem;border-bottom:1px solid rgba(184,132,255,.15);background:rgba(8,6,13,.72);backdrop-filter:blur(18px)}.channel-mark,.footer-brand{display:inline-flex;align-items:center;gap:.7rem;min-width:0;text-decoration:none}.nav-logo,.footer-logo{width:42px!important;height:42px!important;object-fit:contain;filter:drop-shadow(0 0 16px rgba(91,200,255,.18))}.channel-mark>span,.footer-brand>span{display:grid;min-width:0}.channel-mark strong{font-family:'Space Grotesk',sans-serif;font-size:.92rem}.channel-mark small,.footer-brand small{color:#8f829a;font-size:.55rem;font-weight:800;letter-spacing:.14em}.twitch-nav nav{display:flex;justify-content:center;gap:1.2rem}.twitch-nav nav a{position:relative;color:#a99daf;font-size:.7rem;font-weight:750;text-decoration:none}.twitch-nav nav a:hover{color:white}.nav-twitch{display:inline-flex;align-items:center;gap:.45rem;min-height:42px;padding:.65rem .8rem;border-radius:9px;background:#9146ff;font-size:.72rem;font-weight:850;text-decoration:none}main{position:relative;z-index:1;width:min(100% - 2rem,1280px);margin:0 auto;padding:clamp(2rem,5vw,4.5rem) 0 7rem}.twitch-footer{position:relative;z-index:1;width:min(100% - 2rem,1280px);margin:0 auto;padding:2rem 0 8rem;display:grid;grid-template-columns:1fr auto auto;align-items:center;gap:2rem;border-top:1px solid rgba(184,132,255,.14);color:#887e91;font-size:.72rem}.twitch-footer strong{color:#eae4ef}.twitch-footer p{margin:0}.twitch-footer>div{display:flex;gap:1rem}.twitch-footer>div a{text-decoration:none}.twitch-footer>div a:hover{color:#b884ff}@media(max-width:700px){.twitch-nav{width:min(100% - 1.2rem,1280px);grid-template-columns:1fr auto;min-height:68px}.twitch-nav nav{display:none}.channel-mark small{display:none}.nav-twitch{min-height:40px}main{width:min(100% - 1rem,1280px);padding-top:1rem;padding-bottom:10rem}.twitch-footer{width:min(100% - 1.2rem,1280px);grid-template-columns:1fr;padding-bottom:11rem}.twitch-footer>div{flex-wrap:wrap}}@media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}}
</style>
