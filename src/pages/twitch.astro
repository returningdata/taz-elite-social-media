---
import PortfolioLayout from '../layouts/PortfolioLayout.astro';
import TwitchStatus from '../components/TwitchStatus.astro';
import { siteConfig } from '../config/site';

const title = 'TazElitePlays Twitch | Taz Elite';
const description = 'Watch TazElitePlays live on Twitch, explore recent broadcasts and clips, view the streaming schedule, and join the Taz Elite gaming community.';
---

<PortfolioLayout title={title} description={description} image={siteConfig.brand.logoLarge}>
  <section class="page-shell twitch-page" aria-label="TazElitePlays Twitch hub">
    <TwitchStatus username={siteConfig.integrations.twitchLogin} />
  </section>
</PortfolioLayout>

<style>
  .twitch-page{padding-top:clamp(2.5rem,6vw,5rem)}
</style>
